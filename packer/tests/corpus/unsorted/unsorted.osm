<?xml version='1.0' encoding='UTF-8'?>
<!--
  Hand-authored obc-pack corpus fixture: a deliberately UNSORTED .osm — the way
  is written before the nodes it references.

  A real PBF is type-sorted (nodes, then ways, then relations), and `--bbox`'s
  pass 0 leans on that: it freezes the "inside the box" node set the moment the
  first way arrives. A file in this shape would otherwise select nothing and
  pack a silently empty map, so the packer refuses it by name instead.
  `ingest::tests::bbox_refuses_an_unsorted_pbf` pins that refusal.

  Regenerate the derived .pbf via packer/tests/corpus/build_corpus.sh —
  `osmium cat` preserves the order as written, which is the whole point here.

  Coordinates sit near Freiburg, on the same grid as tiny.osm.
-->
<osm version="0.6" generator="hand-authored-obcm-fixture">
  <way id="1" version="1"><nd ref="1"/><nd ref="2"/><tag k="highway" v="primary"/></way>
  <node id="1" version="1" lat="47.990" lon="7.800"/>
  <node id="2" version="1" lat="47.991" lon="7.801"/>
</osm>
