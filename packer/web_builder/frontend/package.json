{
    "name": "obcm-web-builder",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:web": "vite build --mode web",
        "build:desktop": "vite build --mode desktop",
        "build:all": "npm run build && npm run build:web && npm run build:desktop",
        "build:wasm": "wasm-pack build ../../../firmware/obc-web-convert --release --target web --out-dir ../../packer/web_builder/frontend/src/lib/convert/pkg --out-name obc_web_convert",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "test": "vitest run"
    },
    "dependencies": {
        "leaflet": "^1.9.4"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.0.0",
        "@tsconfig/svelte": "^5.0.4",
        "@types/leaflet": "^1.9.12",
        "@types/node": "^22.20.1",
        "svelte": "^5.20.0",
        "svelte-check": "^4.0.0",
        "typescript": "^5.6.0",
        "vite": "^7.0.0",
        "vitest": "^3.0.0"
    }
}
