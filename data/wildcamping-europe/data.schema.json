{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "European tent and bivouac research dataset",
  "type": "object",
  "required": [
    "metadata",
    "categories",
    "countries",
    "local_rules",
    "sources",
    "research_gaps"
  ],
  "properties": {
    "metadata": {
      "type": "object"
    },
    "categories": {
      "type": "object",
      "required": [
        "green",
        "yellow",
        "orange",
        "red",
        "grey"
      ]
    },
    "countries": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/rule"
          },
          {
            "required": [
              "iso3"
            ],
            "properties": {
              "iso3": {
                "type": "string",
                "pattern": "^[A-Z]{3}$"
              },
              "scope": {
                "const": "country"
              }
            }
          }
        ]
      }
    },
    "local_rules": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/rule"
          },
          {
            "required": [
              "country_id",
              "location",
              "geometry_role"
            ],
            "properties": {
              "geometry_role": {
                "const": "overview_marker_not_boundary"
              }
            }
          }
        ]
      }
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "title",
          "url",
          "publisher",
          "type",
          "accessed",
          "review_method"
        ],
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          },
          "accessed": {
            "type": "string",
            "format": "date"
          }
        }
      }
    },
    "research_gaps": {
      "type": "array"
    }
  },
  "$defs": {
    "rule": {
      "type": "object",
      "required": [
        "id",
        "name",
        "category",
        "tent_category",
        "bivouac_category",
        "summary",
        "tent_status",
        "bivouac_status",
        "conditions",
        "source_ids",
        "confidence",
        "gaps",
        "limits",
        "tolerance",
        "enforcement",
        "reviewed_at",
        "vehicle_overnight",
        "scope"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "category": {
          "enum": [
            "green",
            "yellow",
            "orange",
            "red",
            "grey"
          ]
        },
        "tent_category": {
          "enum": [
            "green",
            "yellow",
            "orange",
            "red",
            "grey"
          ]
        },
        "bivouac_category": {
          "enum": [
            "green",
            "yellow",
            "orange",
            "red",
            "grey"
          ]
        },
        "summary": {
          "type": "string"
        },
        "conditions": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "confidence": {
          "enum": [
            "high",
            "medium",
            "low"
          ]
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "limits": {
          "type": "object"
        },
        "tolerance": {
          "type": "object",
          "required": [
            "status",
            "source_ids"
          ]
        },
        "enforcement": {
          "type": "object",
          "required": [
            "status",
            "source_ids",
            "penalty"
          ]
        },
        "reviewed_at": {
          "type": "string",
          "format": "date"
        },
        "vehicle_overnight": {
          "const": "out_of_scope"
        },
        "location": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "array",
              "items": {
                "type": "number"
              },
              "minItems": 2,
              "maxItems": 2
            }
          ]
        },
        "season": {
          "type": "object"
        },
        "map_admin1": {
          "type": "string"
        },
        "map_terrain": {
          "enum": [
            "general",
            "above_tree_line"
          ]
        },
        "map_admin1_codes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        }
      }
    }
  }
}
