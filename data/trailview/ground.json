{
  "about": "The ground sources of the TrailView material and lithology, in the order they apply: specs/trailview-tiles.md, Ground. A source is a row of data/sources.toml.",
  "material": {
    "about": "WorldCover's 10 m keeps the structure; a 100 m map only names it. A map's heath or bog leaves the satellite's heath as it is; a map's farmland outranks it, as no heath is farmed. WorldCover sees a crop planted in rows as what grows in them.",
    "refines": {
      "needleleaf-forest": ["forest"],
      "broadleaf-forest": ["forest"],
      "mixed-forest": ["forest"],
      "sclerophyllous-scrub": ["scrub"],
      "heath": ["sparse", "moss-lichen", "marsh"],
      "bog": ["sparse", "moss-lichen", "marsh", "heath"],
      "pasture": ["grassland", "heath"],
      "rough-grass": ["grassland"],
      "wet-grassland": ["grassland"],
      "salt-marsh": ["marsh"],
      "rice": ["arable"],
      "vineyard": ["arable", "forest", "scrub", "grassland", "heath"],
      "orchard": ["arable", "forest", "scrub", "grassland", "heath"],
      "olive-grove": ["arable", "forest", "scrub", "grassland", "heath"],
      "bare-soil": ["sparse"],
      "bare-rock": ["sparse"],
      "scree": ["sparse", "bare-rock"],
      "sand": ["sparse"],
      "beach": ["sparse", "sand"]
    },
    "sources": [
      {
        "source": "esa-worldcover",
        "protocol": "raster",
        "px_m": 10,
        "combine": "authority",
        "legend": {
          "match": "code",
          "classes": [
            ["10", "forest"],
            ["20", "scrub"],
            ["30", "grassland"],
            ["40", "arable"],
            ["50", "built-up"],
            ["60", "sparse"],
            ["70", "glacier"],
            ["80", "inland-water"],
            ["90", "marsh"],
            ["95", "marsh"],
            ["100", "moss-lichen"]
          ]
        }
      },
      {
        "source": "sentinel-2-mosaics",
        "rule": "satellite-heath",
        "material": "heath",
        "about": "Open ground as red as it is green (the midpoint of 1.1 to 1.4) while its NDVI is high and near the year's highest. Not on sparse ground: a green pixel there is grass beside bare stone. Grass that a dry summer turns as red is green in spring, while heather and moor grass stay brown until midsummer; heather shuns lime, so on calcareous rock such ground is the dry grass.",
        "on": ["grassland", "scrub", "moss-lichen", "marsh"],
        "green_red": 1.25,
        "ndvi": 0.45,
        "peak": 0.1,
        "spring_green_red": 1.1,
        "spring_on": ["limestone", "chalk", "limestone-marl"]
      },
      {
        "source": "osm-planet",
        "protocol": "osm",
        "combine": "refine",
        "legend": {
          "match": "tags",
          "classes": [
            [{"landuse": "forest", "leaf_type": "needleleaved"}, "needleleaf-forest"],
            [{"landuse": "forest", "leaf_type": "broadleaved"}, "broadleaf-forest"],
            [{"landuse": "forest", "leaf_type": "mixed"}, "mixed-forest"],
            [{"natural": "wood", "leaf_type": "needleleaved"}, "needleleaf-forest"],
            [{"natural": "wood", "leaf_type": "broadleaved"}, "broadleaf-forest"],
            [{"natural": "wood", "leaf_type": "mixed"}, "mixed-forest"]
          ]
        }
      },
      {
        "source": "corine-land-cover",
        "protocol": "arcgis-image",
        "layer": "1",
        "crs": "EPSG:3035",
        "px_m": 100,
