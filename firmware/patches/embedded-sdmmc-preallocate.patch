diff --git a/src/volume_mgr.rs b/src/volume_mgr.rs
index 85a88f5..9ff8f0b 100644
--- a/src/volume_mgr.rs
+++ b/src/volume_mgr.rs
@@ -777,6 +777,83 @@ where
         Ok(read)
     }
 
+    /// **Reserve the cluster chain for a file whose final length is already known.**
+    ///
+    /// Answers how many clusters were added (0 when the chain is already long enough).
+    ///
+    /// [`write`](Self::write) extends a file one cluster at a time, at the moment it runs off the
+    /// end — and each of those extensions costs four single-block device writes (`update_fat` twice,
+    /// each mirrored across both FATs). On an SD card a single-block write is a whole internal
+    /// program cycle, so streaming a 300 MB file pays ~38,000 of them *interleaved with the data*,
+    /// which is exactly where they hurt: they land between the multi-block bursts that
+    /// [`write`](Self::write) exists to produce.
+    ///
+    /// A caller that knows the length up front — a network or USB transfer that announced it — can
+    /// hoist all of that out of the streaming path with one call. The allocation itself is also much
+    /// cheaper than the sum of the per-cluster ones, because it fills whole FAT blocks before
+    /// writing them back: one FAT32 block chains 128 clusters, so 4 MiB of file costs the four
+    /// writes that 32 KiB used to.
+    ///
+    /// **This does not change the file's length.** Only [`write`](Self::write) does that, so a file
+    /// pre-allocated and then written short leaves a chain longer than its size — allocated space
+    /// that no data uses. Pre-allocate what you will actually write, or truncate afterwards.
+    ///
+    /// Returns short rather than failing if the volume runs out of room, so an optimistic caller can
+    /// carry on and let the ordinary write path report [`Error::DiskFull`].
+    pub fn preallocate(&self, file: RawFile, len: u32) -> Result<u32, Error<D::Error>> {
+        let mut data = self.data.try_borrow_mut().map_err(|_| Error::LockError)?;
+        let data = data.deref_mut();
+        let file_idx = data.get_file_by_id(file)?;
+        let volume_idx = data.get_volume_by_id(data.open_files[file_idx].raw_volume)?;
+        if data.open_files[file_idx].mode == Mode::ReadOnly {
+            return Err(Error::ReadOnly);
+        }
+
+        // A chain to extend has to exist first. Same first-cluster allocation `write` does, so a
+        // freshly created (zero-length) file is a valid target.
+        if data.open_files[file_idx].entry.cluster.0 < fat::RESERVED_ENTRIES {
+            data.open_files[file_idx].entry.cluster = match data.open_volumes[volume_idx].volume_type
+            {
+                VolumeType::Fat(ref mut fat) => fat.alloc_cluster(&mut data.block_cache, None, false)?,
+            };
+            data.open_files[file_idx].dirty = true;
+        }
+
+        let bytes_per_cluster = match &data.open_volumes[volume_idx].volume_type {
+            VolumeType::Fat(fat) => fat.bytes_per_cluster(),
+        };
+        let wanted = len / bytes_per_cluster + u32::from(len % bytes_per_cluster != 0);
+
+        // Walk to the end of whatever the file already has. Cheap for the case this exists for — a
+        // file that was just created and holds one cluster — and correct for any other.
+        let mut last = data.open_files[file_idx].entry.cluster;
+        let mut held: u32 = 1;
+        loop {
+            let next = match data.open_volumes[volume_idx].volume_type {
+                VolumeType::Fat(ref fat) => fat.next_cluster(&mut data.block_cache, last),
+            };
+            match next {
+                Ok(cluster) => {
+                    last = cluster;
+                    held = held.saturating_add(1);
+                }
+                Err(Error::EndOfFile) => break,
+                Err(e) => return Err(e),
+            }
+        }
+        if wanted <= held {
+            return Ok(0);
+        }
+
+        let (_, allocated) = match data.open_volumes[volume_idx].volume_type {
+            VolumeType::Fat(ref mut fat) => {
+                fat.alloc_cluster_run(&mut data.block_cache, last, wanted - held)?
+            }
+        };
+        debug!("Pre-allocated {} cluster(s) for {:?}", allocated, file);
+        Ok(allocated)
+    }
+
     /// Write to a open file.
     pub fn write(&self, file: RawFile, buffer: &[u8]) -> Result<(), Error<D::Error>> {
         #[cfg(feature = "defmt-log")]
diff --git a/tests/preallocate.rs b/tests/preallocate.rs
new file mode 100644
index 0000000..c76acb8
--- /dev/null
+++ b/tests/preallocate.rs
@@ -0,0 +1,392 @@
+//! Cluster pre-allocation tests.
+//!
+//! `VolumeManager::write` extends a file one cluster at a time, at the moment it runs off the end,
+//! and each of those extensions is four single-block device writes (`update_fat` twice, mirrored
+//! across both FATs). `VolumeManager::preallocate` hoists all of them out of the streaming path and
+//! fills whole FAT blocks before writing them back, so the FAT traffic drops by roughly the number
+//! of entries a block holds.
+//!
+//! These tests pin both halves: that the bookkeeping actually leaves the write path, and that a file
+//! written into a pre-allocated chain still reads back byte for byte.
+
+use embedded_sdmmc::{Block, BlockCount, BlockDevice, BlockIdx, Mode, VolumeIdx, VolumeManager};
+
+mod utils;
+
+/// A block device that records the shape of every write, so a test can assert on how much
+/// bookkeeping reached the card rather than only on the bytes coming back.
+struct Counting<D> {
+    inner: D,
+    writes: std::cell::RefCell<Vec<usize>>,
+    /// `(start block, block count)` per write, for the tests that care about *order* rather than
+    /// volume — the FAT write order is a crash-safety property, not a throughput one.
+    sites: std::cell::RefCell<Vec<(u32, usize)>>,
+}
+
+impl<D> Counting<D> {
+    fn new(inner: D) -> Self {
+        Counting {
+            inner,
+            writes: std::cell::RefCell::new(Vec::new()),
+            sites: std::cell::RefCell::new(Vec::new()),
+        }
+    }
+
+    /// Write calls carrying exactly one block — the FAT and directory bookkeeping, plus any
+    /// read-modify-write of a partial end.
+    fn single_block_writes(&self) -> usize {
+        self.writes.borrow().iter().filter(|&&n| n == 1).count()
+    }
+
+    /// The block index of every single-block write, in the order they were issued.
+    fn single_block_lbas(&self) -> Vec<u32> {
+        self.sites
+            .borrow()
+            .iter()
+            .filter(|(_, blocks)| *blocks == 1)
+            .map(|(lba, _)| *lba)
+            .collect()
+    }
+
+    fn reset(&self) {
+        self.writes.borrow_mut().clear();
+        self.sites.borrow_mut().clear();
+    }
+}
+
+impl<D: BlockDevice> BlockDevice for Counting<D> {
+    type Error = D::Error;
+
+    fn read(&self, blocks: &mut [Block], start_block_idx: BlockIdx) -> Result<(), Self::Error> {
+        self.inner.read(blocks, start_block_idx)
+    }
+
+    fn write(&self, blocks: &[Block], start_block_idx: BlockIdx) -> Result<(), Self::Error> {
+        self.writes.borrow_mut().push(blocks.len());
+        self.sites
+            .borrow_mut()
+            .push((start_block_idx.0, blocks.len()));
+        self.inner.write(blocks, start_block_idx)
+    }
+
+    fn num_blocks(&self) -> Result<BlockCount, Self::Error> {
+        self.inner.num_blocks()
+    }
+}
+
+struct Shared<'a, D>(&'a D);
+
+impl<D: BlockDevice> BlockDevice for Shared<'_, D> {
+    type Error = D::Error;
+
+    fn read(&self, blocks: &mut [Block], start_block_idx: BlockIdx) -> Result<(), Self::Error> {
+        self.0.read(blocks, start_block_idx)
+    }
+
+    fn write(&self, blocks: &[Block], start_block_idx: BlockIdx) -> Result<(), Self::Error> {
+        self.0.write(blocks, start_block_idx)
+    }
+
+    fn num_blocks(&self) -> Result<BlockCount, Self::Error> {
+        self.0.num_blocks()
+    }
+}
+
+type Disk<'a> = Shared<'a, Counting<utils::RamDisk<Vec<u8>>>>;
+type Mgr<'a> = VolumeManager<Disk<'a>, utils::TestTimeSource, 4, 2, 1>;
+
+fn pattern(len: usize) -> Vec<u8> {
+    (0..len)
+        .map(|i| ((i / Block::LEN) as u8).wrapping_mul(31) ^ (i % 251) as u8)
+        .collect()
+}
+
+/// Write `data` to a fresh `NAME`, optionally pre-allocating first, and read it back through a new
+/// handle. Answers the read-back bytes and the single-block writes the *streaming* half cost.
+fn round_trip(dev: &Counting<utils::RamDisk<Vec<u8>>>, name: &str, data: &[u8], prealloc: bool) -> (Vec<u8>, usize) {
+    let volume_mgr: Mgr<'_> =
+        VolumeManager::new_with_limits(Shared(dev), utils::make_time_source(), 0xAA00_0000);
+    let volume = volume_mgr
+        .open_raw_volume(VolumeIdx(0))
+        .expect("open volume");
+    let root_dir = volume_mgr.open_root_dir(volume).expect("open root dir");
+
+    let f = volume_mgr
+        .open_file_in_dir(root_dir, name, Mode::ReadWriteCreateOrTruncate)
+        .expect("open file");
+    if prealloc {
+        let clusters = volume_mgr
+            .preallocate(f, data.len() as u32)
+            .expect("preallocate");
+        assert!(clusters > 0, "pre-allocation added no clusters");
+    }
+    // Only the streaming half is measured — pre-allocation's whole claim is about what the *write*
+    // path costs, not about moving the same work earlier.
+    dev.reset();
+    volume_mgr.write(f, data).expect("file write");
+    volume_mgr.close_file(f).expect("close file");
+    let streaming_singles = dev.single_block_writes();
+
+    let f = volume_mgr
+        .open_file_in_dir(root_dir, name, Mode::ReadOnly)
+        .expect("reopen file");
+    assert_eq!(
+        volume_mgr.file_length(f).expect("length"),
+        data.len() as u32,
+        "pre-allocation must not change the file's length"
+    );
+    let mut back = vec![0u8; data.len()];
+    let n = volume_mgr.read(f, &mut back).expect("file read");
+    assert_eq!(n, back.len(), "short read");
+    volume_mgr.close_file(f).expect("close file");
+
+    volume_mgr.close_dir(root_dir).expect("close dir");
+    volume_mgr.close_volume(volume).expect("close volume");
+    (back, streaming_singles)
+}
+
+/// The headline: pre-allocating takes the per-cluster FAT writes out of the streaming path, and the
+/// bytes still land exactly where they belong.
+#[test]
+fn preallocation_takes_fat_writes_out_of_the_write_path() {
+    const LEN: usize = 256 * 1024;
+    let data = pattern(LEN);
+
+    let plain_dev = Counting::new(utils::make_block_device(utils::DISK_SOURCE).unwrap());
+    let (plain_back, plain_singles) = round_trip(&plain_dev, "PLAIN.BIN", &data, false);
+    assert!(plain_back == data, "read-back differs without pre-allocation");
+
+    let pre_dev = Counting::new(utils::make_block_device(utils::DISK_SOURCE).unwrap());
+    let (pre_back, pre_singles) = round_trip(&pre_dev, "PRE.BIN", &data, true);
+    assert!(pre_back == data, "read-back differs with pre-allocation");
+
+    println!("SAVING: {LEN} B: single-block writes in the write path {plain_singles} -> {pre_singles}");
+    assert!(
+        pre_singles < plain_singles,
+        "pre-allocation left {pre_singles} single-block writes in the write path against \
+         {plain_singles} without it — the FAT bookkeeping never moved"
+    );
+}
+
+/// Pre-allocating a chain and then *not* filling it must not corrupt the volume: the file reads back
+/// at its written length, and the tail clusters are simply allocated and unused.
+#[test]
+fn a_short_write_into_a_preallocated_chain_is_still_correct() {
+    const RESERVED: usize = 128 * 1024;
+    const WRITTEN: usize = 3 * 1024;
+
+    let dev = Counting::new(utils::make_block_device(utils::DISK_SOURCE).unwrap());
+    let volume_mgr: Mgr<'_> =
+        VolumeManager::new_with_limits(Shared(&dev), utils::make_time_source(), 0xAA00_0000);
+    let volume = volume_mgr
+        .open_raw_volume(VolumeIdx(0))
+        .expect("open volume");
+    let root_dir = volume_mgr.open_root_dir(volume).expect("open root dir");
+
+    let data = pattern(WRITTEN);
+    let f = volume_mgr
+        .open_file_in_dir(root_dir, "SHORT.BIN", Mode::ReadWriteCreateOrTruncate)
+        .expect("open file");
+    volume_mgr
+        .preallocate(f, RESERVED as u32)
+        .expect("preallocate");
+    volume_mgr.write(f, &data).expect("file write");
+    volume_mgr.close_file(f).expect("close file");
+
+    let f = volume_mgr
+        .open_file_in_dir(root_dir, "SHORT.BIN", Mode::ReadOnly)
+        .expect("reopen file");
+    assert_eq!(
+        volume_mgr.file_length(f).expect("length"),
+        WRITTEN as u32,
+        "the file grew to its reservation"
+    );
+    let mut back = vec![0u8; WRITTEN];
+    assert_eq!(volume_mgr.read(f, &mut back).expect("read"), WRITTEN);
+    assert!(back == data, "read-back differs after a short write");
+    volume_mgr.close_file(f).expect("close file");
+
+    // A second file must still be allocatable — i.e. the reservation did not leave the free-cluster
+    // bookkeeping pointing into the middle of a chain it had just built.
+    let g = volume_mgr
+        .open_file_in_dir(root_dir, "AFTER.BIN", Mode::ReadWriteCreateOrTruncate)
+        .expect("open second file");
+    let more = pattern(64 * 1024);
+    volume_mgr.write(g, &more).expect("second write");
+    volume_mgr.close_file(g).expect("close second file");
+    let g = volume_mgr
+        .open_file_in_dir(root_dir, "AFTER.BIN", Mode::ReadOnly)
+        .expect("reopen second file");
+    let mut back = vec![0u8; more.len()];
+    assert_eq!(volume_mgr.read(g, &mut back).expect("read"), more.len());
+    assert!(back == more, "the second file was written over the first's reservation");
+    volume_mgr.close_file(g).expect("close second file");
+
+    volume_mgr.close_dir(root_dir).expect("close dir");
+    volume_mgr.close_volume(volume).expect("close volume");
+}
+
+/// Pre-allocating what the file already holds is a no-op, and pre-allocating twice does not
+/// double-book: the chain is measured, not assumed.
+#[test]
+fn preallocation_is_idempotent() {
+    const LEN: usize = 64 * 1024;
+
+    let dev = Counting::new(utils::make_block_device(utils::DISK_SOURCE).unwrap());
+    let volume_mgr: Mgr<'_> =
+        VolumeManager::new_with_limits(Shared(&dev), utils::make_time_source(), 0xAA00_0000);
+    let volume = volume_mgr
+        .open_raw_volume(VolumeIdx(0))
+        .expect("open volume");
+    let root_dir = volume_mgr.open_root_dir(volume).expect("open root dir");
+
+    let f = volume_mgr
+        .open_file_in_dir(root_dir, "TWICE.BIN", Mode::ReadWriteCreateOrTruncate)
+        .expect("open file");
+    let first = volume_mgr.preallocate(f, LEN as u32).expect("preallocate");
+    assert!(first > 0);
+    let second = volume_mgr.preallocate(f, LEN as u32).expect("preallocate again");
+    assert_eq!(second, 0, "the second reservation allocated {second} more clusters");
+
+    let data = pattern(LEN);
+    volume_mgr.write(f, &data).expect("file write");
+    volume_mgr.close_file(f).expect("close file");
+
+    let f = volume_mgr
+        .open_file_in_dir(root_dir, "TWICE.BIN", Mode::ReadOnly)
+        .expect("reopen file");
+    let mut back = vec![0u8; LEN];
+    assert_eq!(volume_mgr.read(f, &mut back).expect("read"), LEN);
+    assert!(back == data, "read-back differs after a double reservation");
+    volume_mgr.close_file(f).expect("close file");
+
+    volume_mgr.close_dir(root_dir).expect("close dir");
+    volume_mgr.close_volume(volume).expect("close volume");
+}
+
+/// **The new run's FAT entries reach the card before the link that points at them.**
+///
+/// This is the crash-safety order upstream's `alloc_cluster` uses, and getting it backwards is
+/// silent: a power cut between the link and the run leaves a chain pointing at clusters the FAT
+/// still reports free, and the next allocation hands them to another file. The opposite mistake — a
+/// cut after the run and before the link — leaks an unreferenced run, which `chkdsk` reclaims.
+///
+/// Read without any filesystem geometry. Per run, the allocator issues `write_chain_run`'s block
+/// (and its FAT mirror) followed by `update_fat`'s block (and its mirror) — four single-block
+/// writes. Whenever a run opens in a *later* FAT block than the tail it is linked to, the run's
+/// block index is the larger of the two, so the correct order shows up as the group's first LBA
+/// being **above** its third. The buggy order is the exact inverse, so this cannot pass by accident.
+#[test]
+fn the_run_is_written_before_the_link_that_points_at_it() {
+    // Big enough that the reservation runs past the end of one FAT block several times over.
+    const RESERVED: u32 = 8 * 1024 * 1024;
+
+    let dev = Counting::new(utils::make_block_device(utils::DISK_SOURCE).unwrap());
+    let volume_mgr: Mgr<'_> =
+        VolumeManager::new_with_limits(Shared(&dev), utils::make_time_source(), 0xAA00_0000);
+    let volume = volume_mgr
+        .open_raw_volume(VolumeIdx(0))
+        .expect("open volume");
+    let root_dir = volume_mgr.open_root_dir(volume).expect("open root dir");
+    let f = volume_mgr
+        .open_file_in_dir(root_dir, "ORDER.BIN", Mode::ReadWriteCreateOrTruncate)
+        .expect("open file");
+    // Give the file its first cluster before the recording starts, so every write below belongs to a
+    // *run* and the grouping is uniform. This is also how the caller this exists for behaves — the
+    // firmware writes a four-byte magic placeholder before it reserves.
+    volume_mgr.write(f, &[0u8; 4]).expect("magic placeholder");
+
+    dev.reset();
+    let clusters = volume_mgr.preallocate(f, RESERVED).expect("preallocate");
+    assert!(clusters > 1, "reservation was one cluster — nothing to order");
+    let lbas = dev.single_block_lbas();
+
+    // This image mirrors its FAT, so every entry update is two writes and every run is a group of
+    // four. If that stops being true the grouping below is wrong and should be re-derived rather
+    // than quietly re-tuned.
+    assert_eq!(
+        lbas.len() % 4,
+        0,
+        "expected 4 single-block writes per run (run + mirror, link + mirror), got {} — is this \
+         image's FAT still mirrored?",
+        lbas.len()
+    );
+
+    let mut crossings = 0;
+    for group in lbas.chunks_exact(4) {
+        let (run_block, link_block) = (group[0], group[2]);
+        if run_block == link_block {
+            // The run opened in the same FAT block as the tail it links to; one cached block carries
+            // both updates and the order is unobservable — and harmless, because one write-back
+            // makes them durable together.
+            continue;
+        }
+        crossings += 1;
+        assert!(
+            run_block > link_block,
+            "a run opening in a later FAT block was written at {run_block} *after* its tail link at \
+             {link_block} — that is the inverted, cross-linking order"
+        );
+    }
+    assert!(
+        crossings > 0,
+        "no run crossed a FAT block boundary, so nothing about the order was actually tested"
+    );
+
+    volume_mgr.close_file(f).expect("close file");
+    volume_mgr.close_dir(root_dir).expect("close dir");
+    volume_mgr.close_volume(volume).expect("close volume");
+}
+
+/// **A reservation across a fragmented volume leaves the files already on it alone.**
+///
+/// This image ships a 64 MB file, so a large reservation has to stop at every taken entry it meets
+/// and resume past it — the path where a run that mis-measured its free space would re-point somebody
+/// else's chain. Reading the shipped file back end to end is what would notice.
+///
+/// The *refusal* that guards the same failure one level down —
+/// `free_run_within_block` answering `run.max(1)` for an entry the FAT says is taken — is not
+/// reachable from here and is unit-tested in `fat::volume::tests::a_taken_entry_is_refused_not_claimed`
+/// instead.
+#[test]
+fn a_fragmented_reservation_leaves_existing_files_alone() {
+    let dev = Counting::new(utils::make_block_device(utils::DISK_SOURCE).unwrap());
+    let volume_mgr: Mgr<'_> =
+        VolumeManager::new_with_limits(Shared(&dev), utils::make_time_source(), 0xAA00_0000);
+    let volume = volume_mgr
+        .open_raw_volume(VolumeIdx(0))
+        .expect("open volume");
+    let root_dir = volume_mgr.open_root_dir(volume).expect("open root dir");
+
+    let f = volume_mgr
+        .open_file_in_dir(root_dir, "FRAG.BIN", Mode::ReadWriteCreateOrTruncate)
+        .expect("open file");
+    volume_mgr
+        .preallocate(f, 4 * 1024 * 1024)
+        .expect("preallocate");
+    volume_mgr.close_file(f).expect("close file");
+
+    let victim = volume_mgr
+        .open_file_in_dir(root_dir, "64MB.DAT", Mode::ReadOnly)
+        .expect("open the pre-existing file");
+    assert_eq!(
+        volume_mgr.file_length(victim).expect("length"),
+        64 * 1024 * 1024,
+        "the reservation changed a file that was already on the volume"
+    );
+    // Walking it is what actually follows the chain a bad run would have stolen from.
+    let mut scratch = vec![0u8; 64 * 1024];
+    let mut total = 0u64;
+    loop {
+        let n = volume_mgr.read(victim, &mut scratch).expect("read");
+        if n == 0 {
+            break;
+        }
+        total += n as u64;
+    }
+    assert_eq!(total, 64 * 1024 * 1024, "the pre-existing file lost bytes");
+    volume_mgr.close_file(victim).expect("close");
+
+    volume_mgr.close_dir(root_dir).expect("close dir");
+    volume_mgr.close_volume(volume).expect("close volume");
+}
