diff --git a/src/fat/volume.rs b/src/fat/volume.rs
index ed39b6a..ae3b7ad 100644
--- a/src/fat/volume.rs
+++ b/src/fat/volume.rs
@@ -1097,6 +1097,183 @@ impl FatVolume {
         Err(Error::NotEnoughSpace)
     }
 
+    /// How many FAT entries one 512-byte block holds, and how wide one entry is.
+    fn fat_entry_shape(&self) -> (u32, u32) {
+        match &self.fat_specific_info {
+            FatSpecificInfo::Fat16(_) => (2, Block::LEN_U32 / 2),
+            FatSpecificInfo::Fat32(_) => (4, Block::LEN_U32 / 4),
+        }
+    }
+
+    /// Where `cluster`'s FAT entry lives: its block in FAT 1, the mirror in FAT 2 (if there is one),
+    /// and the byte offset inside the block.
+    fn fat_entry_site(&self, cluster: ClusterId) -> (BlockIdx, Option<BlockIdx>, usize) {
+        let (width, _) = self.fat_entry_shape();
+        let fat_offset = cluster.0 * width;
+        let primary = self.lba_start + self.fat_start.offset_bytes(fat_offset);
+        let duplicate = self
+            .second_fat_start
+            .map(|second| self.lba_start + second.offset_bytes(fat_offset));
+        (primary, duplicate, (fat_offset % Block::LEN_U32) as usize)
+    }
+
+    /// How many clusters starting at `first` are free **and** share `first`'s FAT block, capped at
+    /// `want`.
+    ///
+    /// The FAT-block bound is what makes the run allocator below sound with a one-block cache: a run
+    /// that stayed inside one block can have all its entries written with a single `read_mut` and a
+    /// single write-back, with no read in between to evict the dirty block.
+    ///
+    /// At least 1 — the caller has already established that `first` is free.
+    fn free_run_within_block<D>(
+        &self,
+        block_cache: &mut BlockCache<D>,
+        first: ClusterId,
+        end_cluster: ClusterId,
+        want: u32,
+    ) -> Result<u32, Error<D::Error>>
+    where
+        D: BlockDevice,
+    {
+        let (width, per_block) = self.fat_entry_shape();
+        let (block_idx, _, offset) = self.fat_entry_site(first);
+        let index_in_block = offset as u32 / width;
+        let ceiling = want
+            .min(per_block - index_in_block)
+            .min(end_cluster.0.saturating_sub(first.0));
+        if ceiling <= 1 {
+            return Ok(1);
+        }
+        let block = block_cache.read(block_idx).map_err(Error::DeviceError)?;
+        let mut run = 0;
+        while run < ceiling {
+            let at = offset + (run * width) as usize;
+            let free = match &self.fat_specific_info {
+                FatSpecificInfo::Fat16(_) => LittleEndian::read_u16(&block[at..=at + 1]) == 0,
+                FatSpecificInfo::Fat32(_) => {
+                    LittleEndian::read_u32(&block[at..=at + 3]) & 0x0FFF_FFFF == 0
+                }
+            };
+            if !free {
+                break;
+            }
+            run += 1;
+        }
+        Ok(run.max(1))
+    }
+
+    /// Chain `first ..= first + run - 1` together, the last entry marked end-of-file, with **one**
+    /// write-back (two device writes where the volume mirrors its FAT).
+    ///
+    /// Every entry is in one block by construction — see [`free_run_within_block`].
+    fn write_chain_run<D>(
+        &mut self,
+        block_cache: &mut BlockCache<D>,
+        first: ClusterId,
+        run: u32,
+    ) -> Result<(), Error<D::Error>>
+    where
+        D: BlockDevice,
+    {
+        let (width, _) = self.fat_entry_shape();
+        let (block_idx, duplicate, offset) = self.fat_entry_site(first);
+        let block = block_cache.read_mut(block_idx).map_err(Error::DeviceError)?;
+        for step in 0..run {
+            let at = offset + (step * width) as usize;
+            let last = step + 1 == run;
+            match &self.fat_specific_info {
+                FatSpecificInfo::Fat16(_) => {
+                    let entry = if last {
+                        0xFFFF
+                    } else {
+                        (first.0 + step + 1) as u16
+                    };
+                    LittleEndian::write_u16(&mut block[at..=at + 1], entry);
+                }
+                FatSpecificInfo::Fat32(_) => {
+                    let entry = if last {
+                        0x0FFF_FFFF
+                    } else {
+                        first.0 + step + 1
+                    };
+                    let existing = LittleEndian::read_u32(&block[at..=at + 3]);
+                    let new = (existing & 0xF000_0000) | (entry & 0x0FFF_FFFF);
+                    LittleEndian::write_u32(&mut block[at..=at + 3], new);
+                }
+            }
+        }
+        match duplicate {
+            Some(duplicate) => block_cache.write_back_with_duplicate(duplicate)?,
+            None => block_cache.write_back()?,
+        }
+        Ok(())
+    }
+
+    /// **Extend `prev_cluster`'s chain by up to `count` clusters, in runs rather than one at a
+    /// time.** Returns the chain's new last cluster and how many clusters were actually added.
+    ///
+    /// This exists for one reason: streaming a large file with
+    /// [`VolumeManager::write`](crate::VolumeManager::write) calls
+    /// [`alloc_cluster`](Self::alloc_cluster) once per cluster, and each of those costs **four**
+    /// single-block device writes — `update_fat` twice (end-of-file on the new cluster, then the
+    /// link from the old tail), each of which writes both copies of the FAT. On an SD card a
+    /// single-block write is a whole internal program cycle, so a 32 KiB cluster pays four of them
+    /// on top of the 32 KiB of data. Allocating ahead in runs writes each FAT block **once**: one
+    /// FAT32 block covers 128 entries, so a 4 MiB span of file costs the same four writes that
+    /// 32 KiB used to.
+    ///
+    /// Runs stop at FAT-block boundaries and at the first non-free entry, so the chain may still be
+    /// fragmented — this is an allocator, not a defragmenter. It returns short (`allocated < count`)
+    /// rather than failing when the volume runs out of space, so a caller pre-allocating optimis-
+    /// tically can carry on and let the ordinary write path report `DiskFull`.
+    pub(crate) fn alloc_cluster_run<D>(
+        &mut self,
+        block_cache: &mut BlockCache<D>,
+        prev_cluster: ClusterId,
+        count: u32,
+    ) -> Result<(ClusterId, u32), Error<D::Error>>
+    where
+        D: BlockDevice,
+    {
+        let end_cluster = ClusterId(self.cluster_count + RESERVED_ENTRIES);
+        let mut prev = prev_cluster;
+        let mut allocated = 0;
+        while allocated < count {
+            let start = match self.next_free_cluster {
+                Some(cluster) if cluster.0 < end_cluster.0 => cluster,
+                _ => ClusterId(RESERVED_ENTRIES),
+            };
+            // The cache is clean here — the previous iteration's `write_chain_run` was the last
+            // thing to touch it — so these scans are free to evict.
+            let first = match self.find_next_free_cluster(block_cache, start, end_cluster) {
+                Ok(cluster) => cluster,
+                Err(_) if start.0 > RESERVED_ENTRIES => {
+                    match self.find_next_free_cluster(
+                        block_cache,
+                        ClusterId(RESERVED_ENTRIES),
+                        end_cluster,
+                    ) {
+                        Ok(cluster) => cluster,
+                        Err(_) => break,
+                    }
+                }
+                Err(_) => break,
+            };
+            let run = self.free_run_within_block(block_cache, first, end_cluster, count - allocated)?;
+            // Link the existing tail at the new run **before** the run's own block goes dirty: the
+            // two are usually different FAT blocks, and the one-block cache cannot hold both.
+            self.update_fat(block_cache, prev, first)?;
+            self.write_chain_run(block_cache, first, run)?;
+            prev = ClusterId(first.0 + run - 1);
+            allocated += run;
+            self.next_free_cluster = Some(ClusterId(prev.0 + 1));
+            if let Some(free) = self.free_clusters_count.as_mut() {
+                *free = free.saturating_sub(run);
+            }
+        }
+        Ok((prev, allocated))
+    }
+
     /// Tries to allocate a cluster
     pub(crate) fn alloc_cluster<D>(
         &mut self,
