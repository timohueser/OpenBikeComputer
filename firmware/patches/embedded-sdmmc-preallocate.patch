diff --git a/src/fat/volume.rs b/src/fat/volume.rs
index ed39b6a..7d21901 100644
--- a/src/fat/volume.rs
+++ b/src/fat/volume.rs
@@ -1097,6 +1097,205 @@ impl FatVolume {
         Err(Error::NotEnoughSpace)
     }
 
+    /// How many FAT entries one 512-byte block holds, and how wide one entry is.
+    fn fat_entry_shape(&self) -> (u32, u32) {
+        match &self.fat_specific_info {
+            FatSpecificInfo::Fat16(_) => (2, Block::LEN_U32 / 2),
+            FatSpecificInfo::Fat32(_) => (4, Block::LEN_U32 / 4),
+        }
+    }
+
+    /// Where `cluster`'s FAT entry lives: its block in FAT 1, the mirror in FAT 2 (if there is one),
+    /// and the byte offset inside the block.
+    fn fat_entry_site(&self, cluster: ClusterId) -> (BlockIdx, Option<BlockIdx>, usize) {
+        let (width, _) = self.fat_entry_shape();
+        let fat_offset = cluster.0 * width;
+        let primary = self.lba_start + self.fat_start.offset_bytes(fat_offset);
+        let duplicate = self
+            .second_fat_start
+            .map(|second| self.lba_start + second.offset_bytes(fat_offset));
+        (primary, duplicate, (fat_offset % Block::LEN_U32) as usize)
+    }
+
+    /// How many clusters starting at `first` are free **and** share `first`'s FAT block, capped at
+    /// `want`.
+    ///
+    /// The FAT-block bound is what makes the run allocator below sound with a one-block cache: a run
+    /// that stayed inside one block can have all its entries written with a single `read_mut` and a
+    /// single write-back, with no read in between to evict the dirty block.
+    ///
+    /// Answers at least 1, or [`Error::AllocationError`] if the entry for `first` is **not** free.
+    /// That is not a "no room" case and must not be treated as one: the caller reached here through
+    /// `find_next_free_cluster`, which just read that same entry and called it free, so a
+    /// disagreement means the FAT was read inconsistently. Claiming the cluster anyway would chain a
+    /// run into somebody else's file, silently — the one failure this allocator could cause that no
+    /// later read would notice.
+    fn free_run_within_block<D>(
+        &self,
+        block_cache: &mut BlockCache<D>,
+        first: ClusterId,
+        end_cluster: ClusterId,
+        want: u32,
+    ) -> Result<u32, Error<D::Error>>
+    where
+        D: BlockDevice,
+    {
+        let (width, per_block) = self.fat_entry_shape();
+        let (block_idx, _, offset) = self.fat_entry_site(first);
+        let index_in_block = offset as u32 / width;
+        let ceiling = want
+            .min(per_block - index_in_block)
+            .min(end_cluster.0.saturating_sub(first.0));
+        // `find_next_free_cluster` answered `first < end_cluster`, and both other terms are at least
+        // 1 for any entry inside a block, so there is always at least one candidate to check. The
+        // block is read even when only one is wanted: this is the check that `first` is actually
+        // free, and skipping it for a run of one would leave exactly the case above unguarded.
+        debug_assert!(ceiling >= 1);
+        let block = block_cache.read(block_idx).map_err(Error::DeviceError)?;
+        let mut run = 0;
+        while run < ceiling {
+            let at = offset + (run * width) as usize;
+            let free = match &self.fat_specific_info {
+                FatSpecificInfo::Fat16(_) => LittleEndian::read_u16(&block[at..=at + 1]) == 0,
+                FatSpecificInfo::Fat32(_) => {
+                    LittleEndian::read_u32(&block[at..=at + 3]) & 0x0FFF_FFFF == 0
+                }
+            };
+            if !free {
+                break;
+            }
+            run += 1;
+        }
+        if run == 0 {
+            warn!(
+                "Free-cluster scan and FAT entry disagree about {:?}; refusing to allocate it",
+                first
+            );
+            return Err(Error::AllocationError);
+        }
+        Ok(run)
+    }
+
+    /// Chain `first ..= first + run - 1` together, the last entry marked end-of-file, with **one**
+    /// write-back (two device writes where the volume mirrors its FAT).
+    ///
+    /// Every entry is in one block by construction — see [`free_run_within_block`].
+    fn write_chain_run<D>(
+        &mut self,
+        block_cache: &mut BlockCache<D>,
+        first: ClusterId,
+        run: u32,
+    ) -> Result<(), Error<D::Error>>
+    where
+        D: BlockDevice,
+    {
+        let (width, _) = self.fat_entry_shape();
+        let (block_idx, duplicate, offset) = self.fat_entry_site(first);
+        let block = block_cache.read_mut(block_idx).map_err(Error::DeviceError)?;
+        for step in 0..run {
+            let at = offset + (step * width) as usize;
+            let last = step + 1 == run;
+            match &self.fat_specific_info {
+                FatSpecificInfo::Fat16(_) => {
+                    let entry = if last {
+                        0xFFFF
+                    } else {
+                        (first.0 + step + 1) as u16
+                    };
+                    LittleEndian::write_u16(&mut block[at..=at + 1], entry);
+                }
+                FatSpecificInfo::Fat32(_) => {
+                    let entry = if last {
+                        0x0FFF_FFFF
+                    } else {
+                        first.0 + step + 1
+                    };
+                    let existing = LittleEndian::read_u32(&block[at..=at + 3]);
+                    let new = (existing & 0xF000_0000) | (entry & 0x0FFF_FFFF);
+                    LittleEndian::write_u32(&mut block[at..=at + 3], new);
+                }
+            }
+        }
+        match duplicate {
+            Some(duplicate) => block_cache.write_back_with_duplicate(duplicate)?,
+            None => block_cache.write_back()?,
+        }
+        Ok(())
+    }
+
+    /// **Extend `prev_cluster`'s chain by up to `count` clusters, in runs rather than one at a
+    /// time.** Returns the chain's new last cluster and how many clusters were actually added.
+    ///
+    /// This exists for one reason: streaming a large file with
+    /// [`VolumeManager::write`](crate::VolumeManager::write) calls
+    /// [`alloc_cluster`](Self::alloc_cluster) once per cluster, and each of those costs **four**
+    /// single-block device writes — `update_fat` twice (end-of-file on the new cluster, then the
+    /// link from the old tail), each of which writes both copies of the FAT. On an SD card a
+    /// single-block write is a whole internal program cycle, so a 32 KiB cluster pays four of them
+    /// on top of the 32 KiB of data. Allocating ahead in runs writes each FAT block **once**: one
+    /// FAT32 block covers 128 entries, so a 4 MiB span of file costs the same four writes that
+    /// 32 KiB used to.
+    ///
+    /// Runs stop at FAT-block boundaries and at the first non-free entry, so the chain may still be
+    /// fragmented — this is an allocator, not a defragmenter. It returns short (`allocated < count`)
+    /// rather than failing when the volume runs out of space, so a caller pre-allocating optimis-
+    /// tically can carry on and let the ordinary write path report `DiskFull`.
+    pub(crate) fn alloc_cluster_run<D>(
+        &mut self,
+        block_cache: &mut BlockCache<D>,
+        prev_cluster: ClusterId,
+        count: u32,
+    ) -> Result<(ClusterId, u32), Error<D::Error>>
+    where
+        D: BlockDevice,
+    {
+        let end_cluster = ClusterId(self.cluster_count + RESERVED_ENTRIES);
+        let mut prev = prev_cluster;
+        let mut allocated = 0;
+        while allocated < count {
+            let start = match self.next_free_cluster {
+                Some(cluster) if cluster.0 < end_cluster.0 => cluster,
+                _ => ClusterId(RESERVED_ENTRIES),
+            };
+            // The cache is clean here — the previous iteration's `write_chain_run` was the last
+            // thing to touch it — so these scans are free to evict.
+            let first = match self.find_next_free_cluster(block_cache, start, end_cluster) {
+                Ok(cluster) => cluster,
+                Err(_) if start.0 > RESERVED_ENTRIES => {
+                    match self.find_next_free_cluster(
+                        block_cache,
+                        ClusterId(RESERVED_ENTRIES),
+                        end_cluster,
+                    ) {
+                        Ok(cluster) => cluster,
+                        Err(_) => break,
+                    }
+                }
+                Err(_) => break,
+            };
+            let run = self.free_run_within_block(block_cache, first, end_cluster, count - allocated)?;
+            // **Order is crash safety, and it is upstream's.** `alloc_cluster` marks the new cluster
+            // end-of-file *before* it links the old tail at it, so a power cut between the two
+            // leaves an allocated cluster nothing points at — a leak the next `chkdsk` reclaims. The
+            // reverse order leaves a chain pointing into clusters the FAT still reports **free**,
+            // which the next allocation happily hands to another file: a silent cross-link. Same
+            // rule here, one run at a time.
+            //
+            // The one-block cache does not argue against it: `write_chain_run` writes its block back
+            // before it returns, so `update_fat` is free to read whichever block it needs — the same
+            // one (a cache hit, re-written with the link added) or another (a clean eviction).
+            self.write_chain_run(block_cache, first, run)?;
+            self.update_fat(block_cache, prev, first)?;
+            prev = ClusterId(first.0 + run - 1);
+            allocated += run;
+            self.next_free_cluster = Some(ClusterId(prev.0 + 1));
+            if let Some(free) = self.free_clusters_count.as_mut() {
+                *free = free.saturating_sub(run);
+            }
+        }
+        Ok((prev, allocated))
+    }
+
     /// Tries to allocate a cluster
     pub(crate) fn alloc_cluster<D>(
         &mut self,
@@ -1438,6 +1637,89 @@ mod tests {
         };
         assert_eq!(sfn, VolumeName::create_from_str("Hello £99").unwrap())
     }
+
+    /// One FAT block over a dummy device, so `free_run_within_block` can be asked about entries the
+    /// public API cannot arrange to disagree about.
+    struct OneBlock {
+        contents: core::cell::RefCell<Block>,
+    }
+
+    impl BlockDevice for OneBlock {
+        type Error = core::convert::Infallible;
+
+        fn read(&self, blocks: &mut [Block], _start: BlockIdx) -> Result<(), Self::Error> {
+            blocks[0] = self.contents.borrow().clone();
+            Ok(())
+        }
+
+        fn write(&self, blocks: &[Block], _start: BlockIdx) -> Result<(), Self::Error> {
+            *self.contents.borrow_mut() = blocks[0].clone();
+            Ok(())
+        }
+
+        fn num_blocks(&self) -> Result<BlockCount, Self::Error> {
+            Ok(BlockCount(1))
+        }
+    }
+
+    /// A minimal FAT16 volume whose FAT starts at block 0, so cluster *n*'s entry is at byte `2n`.
+    fn one_block_fat16() -> FatVolume {
+        FatVolume {
+            lba_start: BlockIdx(0),
+            num_blocks: BlockCount(1),
+            name: VolumeName { contents: *b"TEST       " },
+            blocks_per_cluster: 1,
+            first_data_block: BlockCount(0),
+            fat_start: BlockCount(0),
+            second_fat_start: None,
+            free_clusters_count: None,
+            next_free_cluster: None,
+            cluster_count: 200,
+            fat_specific_info: FatSpecificInfo::Fat16(crate::fat::Fat16Info {
+                first_root_dir_block: BlockCount(0),
+                root_entries_count: 0,
+            }),
+        }
+    }
+
+    /// **A run never starts on an entry the FAT says is taken.**
+    ///
+    /// `free_run_within_block` used to answer `run.max(1)`, which turned a disagreement between the
+    /// free-cluster scan and the entry it landed on into a silent cross-link — a run chained into
+    /// somebody else's file, with nothing downstream to notice. It is a refusal now.
+    ///
+    /// Tested here rather than through `VolumeManager` because the disagreement is not reachable
+    /// from outside: `find_next_free_cluster` and this function read the same FAT through the same
+    /// cache, so only a corrupt read or a future edit can drive them apart. That is exactly what a
+    /// defensive check is for, and it still deserves a test.
+    #[test]
+    fn a_taken_entry_is_refused_not_claimed() {
+        let mut block = Block::new();
+        // Cluster 10 is somebody's. Cluster 11 onwards is free.
+        LittleEndian::write_u16(&mut block[20..=21], 0xFFFF);
+        let device = OneBlock {
+            contents: core::cell::RefCell::new(block),
+        };
+        let mut cache = BlockCache::new(device);
+        let volume = one_block_fat16();
+
+        let taken = volume.free_run_within_block(&mut cache, ClusterId(10), ClusterId(200), 8);
+        assert!(
+            matches!(taken, Err(Error::AllocationError)),
+            "a taken entry must be refused, not claimed; got {taken:?}"
+        );
+
+        // The entry beside it is free, and the run stops where the free space does — no off-by-one
+        // that would let the refusal above be an artefact of scanning nothing.
+        let free = volume
+            .free_run_within_block(&mut cache, ClusterId(11), ClusterId(200), 8)
+            .expect("a free entry must be allocatable");
+        assert_eq!(free, 8);
+        let bounded = volume
+            .free_run_within_block(&mut cache, ClusterId(8), ClusterId(200), 8)
+            .expect("a free entry must be allocatable");
+        assert_eq!(bounded, 2, "the run should have stopped at taken cluster 10");
+    }
 }
 
