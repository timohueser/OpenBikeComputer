			)
			(justify left top)
		)
		(uuid "8d348fa5-a0d4-4dce-99ce-562f451e08de")
	)
	(text "J1: B.Cu solder pads. Mate to the rigid board F.Cu pads with the same numbers.\nJ2: F.Cu gold contacts in the flat pattern. Folding puts them at the FH12 bottom contacts.\nMain-board pinout: GND 1/5/8/12; VBUS 2/3/10/11; CC1 4; D+ 6; D- 7; CC2 9."
		(at 30.48 124.46 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "a0fc075e-b404-4db3-96d1-b9e98ac5c898")
	)
	(text "Flex: 0.11mm nominal. Mating end: 6.50 +/-0.07mm wide; 0.30 +/-0.05mm total thickness.\nStiffener on B.Cu side: 4.5mm minimum length; confirm finished thickness with the fabricator.\nRoute a 90-ohm differential pair with a ground reference. Keep vias out of both bend regions."
		(at 30.48 142.24 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "74e8d756-d8c6-4486-bed9-c20655c92e94")
	)
)
