		(uuid "64bf0e4d-d8b6-4975-bcaf-4f9723e593a4")
	)
	(text "Route D+/D- and CC through the U8 clamp nodes at J3. Keep ground returns short.\nJoin duplicate D+/D- pins at J3. Bond all shell tabs to GND.\nThe main-board nPM1300 supplies the CC pull-downs."
		(at 30.48 137.16 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "41744382-dcab-4d45-a6ce-aec59a75bf3f")
	)
	(text "J1 is a six-pad solder overlap. The flex carries no protection components.\nRigid board: 1.20mm. Main-board USB input setting: 1.2A maximum."
		(at 30.48 152.4 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "aba34d39-6cdc-4cde-ba29-1e7fc37d5fc2")
	)
