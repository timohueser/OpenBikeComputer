	)
	(text "D1 and U8 at USB pins; shortest ground return. Route signal traces through clamp nodes.\nJoin duplicate D+/D- pins at J3. Shell tabs bonded to local ground.\nNo external CC pull-downs: nPM1300 on main board provides Rd."
		(at 30.48 137.16 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "01e8fc49-1cc5-427c-b5d7-b9e75fe0e74a")
	)
	(text "FLEX: 6 nets / 12 contacts; 4 VBUS + 4 GND. Input <=1.2A; respect CC/USB current budget.\n90-ohm differential D+/D-, continuous ground reference through flex; no stubs.\nGold contacts; 0.30 +/-0.05mm total; stiffener >=0.188mm. Check pin 1 / contact side."
		(at 30.48 152.4 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "276427db-24ce-4a6f-af53-6d38dce32529")
	)
