		(layer "Cmts.User")
		(uuid "f06be656-2dea-4d6e-9b62-df37227490d9")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "JLC08161H-3313 / 1.6 mm nominal / 1 oz outer, 0.5 oz inner / ENIG / green mask."
