	(gr_text "ROUTE FIRST: USB 90R on In5.Cu\nUse west corridor around H3; keep reference planes continuous"
		(at 71 111 0)
		(layer "Dwgs.User")
		(uuid "1f144bc2-99f3-40a5-9668-dcd38e2aa07e")
		(effects
			(font
				(size 0.7 0.7)
				(thickness 0.1)
			)
		)
	)
	(gr_text "PLACEMENT CHECKPOINT - ROUTING INCOMPLETE\nLCD-to-cover: 0.50mm. Rear optical material: 0.70mm + 0.10mm assembly gap.\nSH1 + SH2: BMI-S-202-F-20-R frames; fit BMI-S-202-C-20 lids.\nKeep enclosed parts below 1.8mm. Bond frames with a close GND via fence.\nJ3: FH34SRJ-12S-0.5SH(50), gold tail 0.30 +/-0.03mm thick, 6.50 +/-0.05mm wide."
		(at 100 178 0)
		(layer "Dwgs.User")
		(uuid "7cbe46de-9282-46d2-b524-8885090462c8")
		(effects
			(font
				(size 0.7 0.7)
				(thickness 0.1)
			)
		)
	)
	(gr_text "B.Cu ground + stitching between SD and GNSS;\nkeep SD transitions north of the socket contact row"
		(at 132 90.5 0)
		(layer "Dwgs.User")
		(uuid "3e8857a6-29fb-4333-a01a-0d618c1c237d")
		(effects
			(font
				(size 0.7 0.7)
				(thickness 0.1)
			)
		)
	)
	(gr_text "ROUTE FIRST: GNSS RF on F.Cu; drawing is a guide, not copper.\nUse continuous In1.Cu GND under the slot-side corridor.\n0.18mm provisional width; confirm 50R with fabricator.\nKeep J8 accessible; tune and test L1/L5 in the complete enclosure."
		(at 133 104 0)
		(layer "Dwgs.User")
		(uuid "350d34c5-72c0-456d-a64d-bbaf056519b4")
		(effects
			(font
				(size 0.7 0.7)
				(thickness 0.1)
			)
		)
	)
	(gr_text "ASSEMBLY: Keep supplied exposed-pad paste windows. Confirm stencil thickness and voiding.\nAll via holes (0.20 / 0.30 mm drill) are epoxy filled and copper capped; do not fill component holes.\nSelect JLCPCB Epoxy Filled & Capped. Preserve the solder-mask tenting shown."
		(at 100 162 0)
		(layer "Dwgs.User")
		(uuid "5f303e1d-b1fb-438d-a714-5711786b6117")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "LAYOUT GRID: 0.05 mm. Preserve mechanical datums and footprint pad centers."
		(at 100 166 0)
		(layer "Dwgs.User")
		(uuid "6811908e-f3ba-4137-9d59-c92b7b77e8e5")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "LOCAL MASK: U6/U5/U7/J3 expansion 0.045 mm; C24 0.040 mm.\nJ2 pads 9/S2/S5 expansion 0.080 mm; retain the other J2 pad openings.\nGANGED MASK: U4/R68 only. Paste apertures remain separate.\nRetain 0.102 mm minimum mask web and 0.09 mm mask-to-neighboring-copper clearance."
		(at 137 132 0)
		(layer "Dwgs.User")
		(uuid "78cfe4c9-3881-4fe9-be92-d5c1fbced6ef")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left)
		)
	)
	(gr_text "LCD FLEX SLOT 8.6 x 2.8 R0.5; center (99.50,119.45)"
		(at 100 137 0)
		(layer "Dwgs.User")
