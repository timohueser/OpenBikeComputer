	(gr_text "J6 PROVISIONAL SOLDER PADS: verify tail, A/K, LED load, solder process and strain relief with supplier before fabrication."
		(at 100 141 0)
		(layer "Dwgs.User")
		(uuid "32643c52-e8b7-4546-ae14-9ee592dc3502")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
	(gr_text "CRADLE: H3-H6, 4.2x1.6 NPTH; front supports + release access reserved"
		(at 100 57 0)
		(layer "Cmts.User")
		(uuid "fc57a9b5-131d-4b09-8864-af6260bb331e")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "Prototype: verify LM20 QFN RF reference, impedance, antenna tuning and mechanical fit.\nJLCPCB file audit must accept U6 0.20 mm lands at 0.40 mm pitch before fabrication."
		(at 100 142 0)
		(layer "Cmts.User")
		(uuid "1ae472e1-d5bb-428e-bd9e-5cbadd581c65")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "BACKLIGHT: U9 driver and provisional J6 solder pads. Confirm LED stack, load and flex with supplier."
		(at 100 145 0)
		(layer "Cmts.User")
		(uuid "f06be656-2dea-4d6e-9b62-df37227490d9")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "JLC08161H-3313 / 1.6 mm nominal / 1 oz outer, 0.5 oz inner / ENIG / green mask."
		(at 100 147 0)
		(layer "Cmts.User")
		(uuid "fb2fd7d8-def3-46f6-a397-c93772e557d0")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "Through vias only: 0.20 mm minimum drill; 0.15 mm minimum annular ring."
		(at 100 149 0)
		(layer "Cmts.User")
		(uuid "fbad1ecb-fa56-4b83-9620-c63e5fe8bbc7")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "J5: TC2030-CTX-NL. Factory SWD access before display assembly.\nNo paste. Keep 0.508mm from unrelated tracks; preserve probe access."
		(at 100 151 0)
		(layer "Cmts.User")
		(uuid "c1be3d87-a613-4e94-b3a9-472850868022")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "RF TEST: remove R39 (BLE) or R40 (GNSS). Center pad in feed; no branch stub."
		(at 100 153 0)
		(layer "Cmts.User")
		(uuid "bec6bb4a-7566-4d0c-bb55-60522c3328bd")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "JLC08161H-3313: 3313 0.0994 / core 0.100 / 3x2116 0.3568 / core 0.300 mm; symmetric.\nSelect this stack explicitly. Minimum trace 0.102 mm; clearance 0.127 mm. Through vias only.\n50-ohm RF: 0.18 mm outer. 90-ohm USB: 0.125 mm width / 0.225 mm gap on L6.\nConfirm impedance geometry and tolerance with the fabricator."
		(at 100 156 0)
		(layer "Cmts.User")
		(uuid "e567dc0d-0952-429a-9082-65c46e5b72af")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "J3 follows the USB flex model; keep the insertion lane clear.\nJ4 underside: mate battery before seating the PCB/display unit.\nAllow a service loop; J6 and battery lead details remain provisional."
		(at 100 170 0)
		(layer "Cmts.User")
		(uuid "4328e8cc-d8c5-42a2-89b9-cfe6e32f235d")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "GNSS: retain J8 coax pads, R40 isolation link and all tuning footprints.\nCorridor/antenna coupling needs assembled reception tests.\nKeep unrelated signals and vias out of the RF corridor."
		(at 133 113 0)
		(layer "Cmts.User")
		(uuid "6423549c-19eb-5ef5-8e3b-ba1d1b5b3cbb")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "ROUTING PROTOTYPE - NOT FOR FABRICATION"
		(at 100 60 0)
		(layer "Cmts.User")
		(uuid "118f4406-cea0-424e-8ad8-2b4e66b07ae3")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
		)
	)
