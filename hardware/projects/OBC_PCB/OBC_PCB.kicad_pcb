		(layer "Cmts.User")
		(uuid "1ae472e1-d5bb-428e-bd9e-5cbadd581c65")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.12)
			)
		)
	)
	(gr_text "BACKLIGHT: U9 driver fitted. J6 connector and LED load remain undefined."
