(version 1)

# PCBWay standard eight-layer board with drilled through vias.
# Use 35 um finished copper on all layers; 0.5 oz outer foil plated to 1 oz.
# GOVERNS: hardware/projects/OBC_PCB/OBC_PCB.kicad_pcb
# https://www.pcbway.com/capabilities.html
# RULE: trace >= 4 mil (0.1016 mm), rounded up to 0.102 mm.
# RULE: clearance >= 5 mil (0.127 mm); annulus >= 0.15 mm.
# RULE: eight-layer hole-to-copper >= 9 mil; via hole spacing >= 11 mil.
# Board Setup rounds these hole clearances up to 0.23 mm and 0.28 mm.
# https://www.pcbway.com/pcb_prototype/PCB_Solder_mask.html
# RULE: green mask web >= 4 mil (0.102 mm); retain mask checks on all pads.
# USB_90R_TBD targets 90 ohms on L6 between the L5 and L7 ground planes.
# RF_50R_TBD targets 50 ohms on an outer layer over its adjacent ground plane.
# Both geometries need the fabricator's impedance calculation.
# RF_Matching geometry follows the component reference designs.

(rule "Four mil track minimum"
  (constraint track_width (min 0.102mm)))

(rule "Power distribution minimum"
  (condition "A.hasNetclass('Power') || A.hasNetclass('Switching')")
  (constraint track_width (min 0.2mm)))

(rule "Battery and USB input minimum"
  (condition "A.hasNetclass('Power_Input')")
  (constraint track_width (min 0.3mm)))

(rule "Drilled through vias only"
  (constraint disallow micro_via blind_via buried_via))

# U6 and U2 use ground thermal vias between exposed-pad stencil apertures.
# Keep all other unfilled holes out of surface lands to prevent solder loss.
(rule "Through vias clear of surface lands"
  (condition "A.Type == 'Via' && A.Via_Type == 'Through' && B.Type == 'Pad' && B.Hole_Size_X == 0mm && !(A.NetName == 'GND' && B.NetName == 'GND' && ((B.memberOfFootprint('U6') && B.Pad_Number == '53') || (B.memberOfFootprint('U2') && B.Pad_Number == '33')))")
  (constraint physical_hole_clearance (min 0.15mm)))

(rule "Plated component annulus"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.15mm)))

# PCBWay's component-hole spacing is 16 mil, rounded up to 0.41 mm.
(rule "Component drill spacing"
  (condition "A.Type == 'Pad' || B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.41mm)))

(rule "Plated slots"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole' && A.Hole_Size_X != A.Hole_Size_Y")
  (constraint hole_size (min 0.5mm)))

(rule "Nonplated slots"
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical' && A.Hole_Size_X != A.Hole_Size_Y")
  (constraint hole_size (min 0.8mm)))

(rule "USB inner pair width"
  (layer "In5.Cu")
  (condition "A.hasNetclass('USB_90R_TBD')")
  (constraint track_width (min 0.125mm) (opt 0.125mm) (max 0.125mm)))

(rule "USB inner pair gap"
  (layer "In5.Cu")
  (condition "A.hasNetclass('USB_90R_TBD') && AB.isCoupledDiffPair()")
  (constraint diff_pair_gap (min 0.225mm) (opt 0.225mm) (max 0.225mm)))

(rule "RF feed width"
  (condition "A.hasNetclass('RF_50R_TBD')")
  (constraint track_width (min 0.11mm) (opt 0.2mm)))

# Keep the outer pours clear of exposed pads and their solder mask openings.
(rule "Outer pour solder mask clearance"
  (condition "A.Type == 'Zone' && (A.Layer == 'F.Cu' || A.Layer == 'B.Cu')")
  (constraint clearance (min 0.25mm)))

# A wide coplanar gap preserves the microstrip model outside the matching pads.
(rule "RF feed coplanar ground setback"
  (condition "A.Type == 'Track' && A.hasNetclass('RF_50R_TBD') && (A.Layer == 'F.Cu' || A.Layer == 'B.Cu') && B.Type == 'Zone' && B.NetName == 'GND'")
  (constraint clearance (min 0.5mm)))

# https://www.tag-connect.com/wp-content/uploads/bsk-pdf-manager/2019/12/TC2030-IDC-NL-Datasheet-Rev-B.pdf
(rule "Tag-Connect contact clearance"
  (condition "A.memberOfFootprint('J5') && A.Type == 'Pad' && (B.Type == 'Track' || B.Type == 'Via' || B.Type == 'Zone') && A.Net != B.Net")
  (constraint clearance (min 0.508mm)))

# Preserve continuous reference planes and the dedicated supply plane.
(rule "No tracks on reference and supply planes"
  (condition "A.Layer == 'In1.Cu' || A.Layer == 'In3.Cu' || A.Layer == 'In4.Cu' || A.Layer == 'In6.Cu'")
  (constraint disallow track))

(rule "Tracks off the edge"
  (condition "A.Type == 'Track'")
  (constraint edge_clearance (min 1mm)))

(rule "MCU fanout five mil clearance"
  (condition "A.Type != 'Zone' && B.Type != 'Zone' && A.enclosedByArea('MCU south-east fanout') && B.enclosedByArea('MCU south-east fanout')")
  (constraint clearance (min 0.127mm)))
