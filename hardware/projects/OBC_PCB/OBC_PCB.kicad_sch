	)
	(text "LCD SOURCE DAMPING\nR69-R75: 100 Ohm, BCK and data. R76-R80: 220 Ohm, control.\nPlace within 4 mm of U6. Use standard GPIO drive.\nVerify 10-90% edges at J1: target <=25 ns; panel limit 50 ns."
		(exclude_from_sim no)
		(at 332.74 147.32 0)
		(effects
