	(text "VDD bypass: C22 at pad 6; C21 and C23 at pad 42; C24 at pad 51.\nR68 and C55 filter nRESET; place both at pad 33.\nSolder the ground pad (53). Configure both crystal load capacitors\nbefore use. Enable the internal DC/DC converter in firmware."
		(exclude_from_sim no)
		(at 326.39 104.14 0)
		(effects
			(font
				(size 1 1)
			)
			(justify left top)
		)
		(uuid "2fbfd65f-ab06-5a63-aec6-df2735263089")
	)
