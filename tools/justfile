# Run the gates this change selects, then print a pull-request skeleton. The plan gives one line
# and one reason for each gate, the skipped ones included, so the run stays proportional to the
# change. `obc test affected` executes the declared suites, so a gate it covers is skipped there.
# A selection that takes the whole graph is CI's run: the plan then keeps only the suites that
# build nothing and names the rest as left to CI.
#   obc ready --dry-run          obc ready --base origin/develop
# Run the gates this change selects, then print a PR skeleton. Args: [--base REF] [--dry-run]
[group('agent')]
ready *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    cd "$OBC_ROOT"
    _run python3 "$OBC_TOOLS/ready.py" "$@"

# `obc req SYS-003` prints one requirement with its criteria numbered. Also `list`, `proposal ID`,
# `tests QUERY`, `changed --since rN`, `propose plan.json` for a coverage plan, and
# `suggest file.json` for a requirement that does not exist yet or no longer describes the
# product. `suggestions` lists the open ones; `--decided` shows the owner's answer. Check
# `propose` and `suggest` with --check first. Needs the agent token file; see tools/req.py.
# Read and write the verification console. Args: SYS-nnn | list | proposal ID | tests QUERY | changed --since rN | propose plan.json | suggest file.json | suggestions
[group('agent')]
req *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    _run python3 "$OBC_TOOLS/req.py" "$@"

# The raw log of one red job is about a megabyte; this prints each failed step's last lines.
