# OpenBikeComputer dev tasks — invoke with `obc <task>` (see `obc setup`), or
# `just --justfile tools/justfile <task>`. This lives in tools/; OBC_ROOT is its parent
# (the repo root). Personal defaults (map/gpx/preset/toolchain paths) live in a gitignored
# `tools/obc.local` — copy tools/obc.local.example and edit. `OBC_DRY_RUN=1 obc …` prints
# the underlying commands without running them.

set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments := true

export OBC_ROOT  := parent_directory(justfile_directory())   # the repo root
export OBC_TOOLS := justfile_directory()                     # this tools/ dir
lib := justfile_directory() / "obc-dev.sh"

# List the available tasks.
default:
    @just --justfile '{{justfile()}}' --list --unsorted

# ── Simulator ────────────────────────────────────────────────────────────────

# Run the simulator (always --physical). Args: [MAP.obcm] [TRACK.gpx] [-- extra sim flags].
# MAP defaults to $OBC_MAP or the newest .obcm in the repo root; TRACK to $OBC_GPX
# or the bundled grimsel-climb.gpx. Pass `none` as the track to run without a GPS.
# Run the simulator on a map + GPX, always at physical size. Args: [MAP] [TRACK.gpx] [-- sim flags]
sim *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    split_args "$@"
    mapf="$(resolve_map "${_POS[0]:-}")" || exit 1
    gpxf="$(resolve_gpx "${_POS[1]:-}")"
    cmd=(cargo run --release -p obc-sim -- "$mapf" --physical)
    [[ -n "$gpxf" && "$gpxf" != none ]] && cmd+=(--gpx "$gpxf")
    (( ${#_EXTRA[@]} )) && cmd+=("${_EXTRA[@]}")
    cd "$OBC_ROOT"; _run "${cmd[@]}"

# ── Board firmware ───────────────────────────────────────────────────────────

# Build & flash the board. Opts (space-separated): ble  debug-uart  synth  build.
# e.g.  obc flash            (real sensors)   obc flash debug-uart
#       obc flash ble        (companion link) obc flash ble debug-uart
#       obc flash build      (compile only, no flash)
# Build & flash the board. Opts: ble debug-uart synth build (e.g. obc flash ble debug-uart)
flash *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_riscv || exit 1
    ble=0 du=0 synth=0 action=run
    for o in "$@"; do case "$o" in
      ble)                ble=1 ;;
      debug-uart|du)      du=1 ;;
      synth)              synth=1 ;;
      build|build-only)   action=build ;;
      *) _err "unknown flash option: '$o'  (want: ble debug-uart synth build)"; exit 1 ;;
    esac; done
    [[ "$action" == run ]] && { ensure_probe || exit 1; }
    a=(); feats=()
    (( ble ))   && { a+=(--no-default-features); feats+=(ble); }
    (( du ))    && feats+=(debug-uart)
    (( synth )) && feats+=(synth)
    (( ${#feats[@]} )) && a+=(--features "$(IFS=,; echo "${feats[*]}")")
    cd "$OBC_ROOT/firmware/obc-fw-nrf54l"
    # `${a[@]+"${a[@]}"}`, not `"${a[@]}"`: macOS ships bash 3.2, where expanding an EMPTY array
    # under `set -u` is an "unbound variable" error. That is the no-options case — i.e. plain
    # `obc flash`, now the common one since the USB plane stopped being a feature.
    _run cargo "$action" --release ${a[@]+"${a[@]}"}

# Build & flash the 32 KB bootloader (obc-boot). Flash it ONCE: probe-rs writes ELFs at their
# linked addresses, so the app (linked at 0x8000) never touches it afterwards. Opts: rtt (defmt
# over RTT — a debug aid, NOT the shipping shape the 32 KB size guard is measured on), build
# (compile only). Needs no RISC-V toolchain: the bootloader keeps the COM wave alive in software,
# not on the FLPR.
# Build & flash the bootloader — once. Opts: rtt (defmt logging) build (compile only)
flash-boot *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    rtt=0 action=run
    for o in "$@"; do case "$o" in
      rtt)              rtt=1 ;;
      build|build-only) action=build ;;
      *) _err "unknown flash-boot option: '$o'  (want: rtt build)"; exit 1 ;;
    esac; done
    [[ "$action" == run ]] && { ensure_probe || exit 1; }
    a=()
    (( rtt )) && a+=(--features rtt)
    cd "$OBC_ROOT/firmware/obc-boot"
    # Empty-array expansion under bash 3.2 + `set -u` is an error — same guard as `flash`.
    _run cargo "$action" --release ${a[@]+"${a[@]}"}
    # `if`, not a trailing `[[ … ]] && …`: as the recipe's LAST statement, a false test would be the
    # script's exit status, so `flash-boot build` would "fail" after building perfectly.
    if [[ "$action" == run ]]; then
      _say "power-cycle the DK: one short LED0 blink (bootloader), then the app"
    fi

# Feed a recorded ride to a debug-uart board over VCOM (obc-usb-host).
# Args: [TRACK.gpx] [-- --port TTY | --baud N | --list].
# Feed a GPX to a debug-uart board over VCOM. Args: [TRACK.gpx] [-- --port TTY | --list]
uart *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    split_args "$@"
    cd "$OBC_ROOT"
    # `--list` just enumerates serial ports; no GPX needed.
    for e in "${_EXTRA[@]:-}"; do [[ "$e" == --list ]] && { _run cargo run --release -p obc-usb-host -- --list; exit 0; }; done
    gpxf="$(resolve_gpx "${_POS[0]:-}")"
    [[ -z "$gpxf" || "$gpxf" == none ]] && { _err "no GPX to feed. Pass one:  obc uart <track.gpx>"; exit 1; }
    cmd=(cargo run --release -p obc-usb-host -- --gpx "$gpxf")
    (( ${#_EXTRA[@]} )) && cmd+=("${_EXTRA[@]}")
    _run "${cmd[@]}"

# Indoor ride in one step: flash the debug-uart firmware, then feed it a GPX over
# VCOM. Args: [ble] [TRACK.gpx]. Flashes with `probe-rs download` (returns cleanly,
# no RTT), then runs the feeder TUI in the foreground. Want defmt logs too? Run
# `obc flash debug-uart` in a second terminal instead.
# One step: flash debug-uart firmware, then feed it a GPX. Args: [ble] [TRACK.gpx]
debug *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_riscv || exit 1; ensure_probe || exit 1
    ble=""; gpx=""
    for a in "$@"; do case "$a" in ble) ble=ble ;; *) gpx="$a" ;; esac; done
    feats="debug-uart"; nodef=()
    [[ -n "$ble" ]] && { feats="ble,debug-uart"; nodef=(--no-default-features); }
    elf="$OBC_ROOT/firmware/obc-fw-nrf54l/target/thumbv8m.main-none-eabihf/release/obc-fw-nrf54l"
    _say "building debug-uart firmware…"
    # Same bash-3.2 empty-array trap as `flash` above: `nodef` is empty unless `ble` was passed.
    ( cd "$OBC_ROOT/firmware/obc-fw-nrf54l" && _run cargo build --release ${nodef[@]+"${nodef[@]}"} --features "$feats" )
    _say "flashing over J-Link…"
    _run probe-rs download --chip nRF54L15 --verify "$elf"
    _run probe-rs reset --chip nRF54L15
    _say "flashed — starting the feeder (Ctrl-C to stop)…"
    just --justfile '{{justfile()}}' uart ${gpx:+"$gpx"}

# Attach to a running board and stream defmt/RTT — no rebuild, no reflash. Bypasses
# cargo entirely (so nothing recompiles) and uses `probe-rs attach` on the last-built
# ELF (attach programs nothing). Flash first with `obc flash`.
rtt:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_probe || exit 1
    elf="$OBC_ROOT/firmware/obc-fw-nrf54l/target/thumbv8m.main-none-eabihf/release/obc-fw-nrf54l"
    [[ -f "$elf" ]] || { _err "no board ELF yet — flash once first:  obc flash [ble] [debug-uart]"; exit 1; }
    _say "attaching to nRF54L15 — no rebuild, no reflash (decoding $(basename "$elf"))"
    _run probe-rs attach --chip nRF54L15 "$elf"

# ── Map packing & the web builder ────────────────────────────────────────────

# Pack an OSM extract into a .obcm map. Args: <region.osm.pbf> [config.json] [out.obcm]
# [-- --chunk-size N | --no-land]. The config defaults to builder/presets/schema.json —
# the one shipped schema; the output defaults to <region>.obcm in the repo root (so
# `obc sim` picks it up next).
# Pack an OSM extract to a .obcm map. Args: <region.osm.pbf> [preset.json] [out.obcm]
pack *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    split_args "$@"
    pbf="${_POS[0]:-}"
    [[ -n "$pbf" ]] || { _err "usage: obc pack <region.osm.pbf> [preset.json] [out.obcm]"; exit 1; }
    pbf="$(_abspath "$pbf")"
    preset="${_POS[1]:-${OBC_PRESET:-$OBC_ROOT/builder/presets/schema.json}}"; preset="$(_abspath "$preset")"
    out="${_POS[2]:-}"
    if [[ -n "$out" ]]; then out="$(_abspath "$out")"
    else base="$(basename "$pbf")"; base="${base%.osm.pbf}"; base="${base%.pbf}"; out="$OBC_ROOT/${base}.obcm"; fi
    ( cd "$OBC_ROOT" && _run cargo build --release -p obc-pack )
    cmd=("$OBC_ROOT/target/release/obc-pack" "$pbf" "$preset" "$out")
    (( ${#_EXTRA[@]} )) && cmd+=("${_EXTRA[@]}")
    _run "${cmd[@]}"
    _say "wrote $out"

# Bake the published cell catalog. `obc bake` processes every regions.toml entry;
# positional ids narrow it (`obc bake europe/austria --force`). Output goes to
# $OBC_BAKE_TREE (default ~/obc-bake). `verify` and `publish` use that same tree
# automatically, while an explicit tree remains available as their first argument:
#
#   obc bake europe/germany/baden-wuerttemberg
#   obc bake verify
#   obc bake publish                  # plan only
#   obc bake publish --target r2      # upload content first, catalog root last
#   obc bake remove-old-r2            # dry-run old whole-region removal
#   obc bake remove-old-r2 --apply    # perform that exact removal
#
# Publish reads its public URL and R2 credentials from tools/obc.local or the
# environment. The removal command requires a non-root OBC_R2_PREFIX and verifies
# that prefix contains the replacement catalog before touching old root objects.
# Bake, verify, publish, or retire old R2 objects using $OBC_BAKE_TREE
bake *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    if [[ -z "${OBC_PYOSMIUM_UP_TO_DATE:-}" && -x "$OBC_ROOT/.venv/bin/pyosmium-up-to-date" ]]; then
      export OBC_PYOSMIUM_UP_TO_DATE="$OBC_ROOT/.venv/bin/pyosmium-up-to-date"
    fi
    ( cd "$OBC_ROOT" && _run cargo build --release -p obc-bake )
    bin="$OBC_ROOT/target/release/obc-bake"
    tree="${OBC_BAKE_TREE:-$HOME/obc-bake}"
    case "${1:-}" in
      verify)
        shift
        verify_tree="$tree"
        if (( $# )) && [[ "$1" != -* ]]; then verify_tree="$1"; shift; fi
        _run "$bin" verify "$verify_tree" "$@" ;;
      publish)
        shift
        publish_tree="$tree"
        if (( $# )) && [[ "$1" != -* ]]; then publish_tree="$1"; shift; fi
        maps_base="${OBC_MAPS_BASE_URL:-}"
        if [[ -z "$maps_base" && -n "${OBC_CATALOG_URL:-}" ]]; then
          case "$OBC_CATALOG_URL" in
            */catalog.json) maps_base="${OBC_CATALOG_URL%/catalog.json}" ;;
            *)
              _err "OBC_CATALOG_URL must end in /catalog.json: $OBC_CATALOG_URL"
              exit 1 ;;
          esac
        fi
        if [[ -z "$maps_base" ]]; then
          prefix="${OBC_R2_PREFIX:-cell-catalog}"; prefix="${prefix#/}"; prefix="${prefix%/}"
          [[ -n "$prefix" ]] || { _err "OBC_R2_PREFIX may not be empty"; exit 1; }
          export OBC_R2_PREFIX="$prefix"
          maps_base="https://maps.openbikecomputer.com/$prefix"
          _say "using production catalog base: $maps_base"
        fi
        export OBC_MAPS_BASE_URL="$maps_base"
        _run "$bin" publish "$publish_tree" "$@" ;;
      remove-old-r2)
        shift
        apply=0
        for arg in "$@"; do case "$arg" in
          --apply) apply=1 ;;
          *) _err "unknown remove-old-r2 option: '$arg'  (want: --apply)"; exit 1 ;;
        esac; done
        command -v rclone >/dev/null 2>&1 || { _err "rclone is required for R2 cleanup"; exit 1; }
        missing=()
        [[ -n "${OBC_R2_BUCKET:-}" ]] || missing+=(OBC_R2_BUCKET)
        [[ -n "${OBC_R2_ACCESS_KEY_ID:-}" ]] || missing+=(OBC_R2_ACCESS_KEY_ID)
        [[ -n "${OBC_R2_SECRET_ACCESS_KEY:-}" ]] || missing+=(OBC_R2_SECRET_ACCESS_KEY)
        [[ -n "${OBC_R2_ENDPOINT:-}" || -n "${OBC_R2_ACCOUNT_ID:-}" ]] || missing+=(OBC_R2_ACCOUNT_ID)
        if (( ${#missing[@]} )); then
          _err "missing R2 settings: ${missing[*]}"
          _hint "put them in the gitignored tools/obc.local (see tools/obc.local.example)"
          exit 1
        fi
        prefix="${OBC_R2_PREFIX:-}"; prefix="${prefix#/}"; prefix="${prefix%/}"
        [[ -n "$prefix" && "$prefix" != . ]] || {
          _err "OBC_R2_PREFIX must name the fresh replacement prefix (for example: cell-catalog)"
          exit 1
        }
        case "$prefix" in
          catalog.json|regions|regions/*|presets|presets/*)
            _err "unsafe replacement prefix '$prefix' overlaps an old root target"; exit 1 ;;
        esac
        endpoint="${OBC_R2_ENDPOINT:-https://${OBC_R2_ACCOUNT_ID}.r2.cloudflarestorage.com}"
        export RCLONE_CONFIG_OBCR2_TYPE=s3
        export RCLONE_CONFIG_OBCR2_PROVIDER=Cloudflare
        export RCLONE_CONFIG_OBCR2_REGION=auto
        export RCLONE_CONFIG_OBCR2_ENDPOINT="$endpoint"
        export RCLONE_CONFIG_OBCR2_ACCESS_KEY_ID="$OBC_R2_ACCESS_KEY_ID"
        export RCLONE_CONFIG_OBCR2_SECRET_ACCESS_KEY="$OBC_R2_SECRET_ACCESS_KEY"
        export RCLONE_CONFIG_OBCR2_NO_CHECK_BUCKET=true
        root="obcr2:${OBC_R2_BUCKET}"
        replacement="$root/$prefix/catalog.json"
        _say "checking replacement catalog: $replacement"
        rclone lsjson "$replacement" --stat >/dev/null || {
          _err "replacement catalog is not readable; refusing to touch old R2 data"
          exit 1
        }
        if (( apply )); then
          _warn "deleting only the obsolete bucket-root catalog.json, regions/, and presets/"
          _run rclone deletefile "$root/catalog.json"
          _run rclone purge "$root/regions"
          _run rclone purge "$root/presets"
          _ok "old whole-region objects removed; $prefix was untouched"
        else
          _say "dry run — review this list, then repeat with: obc bake remove-old-r2 --apply"
          _run rclone deletefile "$root/catalog.json" --dry-run
          _run rclone purge "$root/regions" --dry-run
          _run rclone purge "$root/presets" --dry-run
        fi ;;
      regions|check-obcm-version|help|-h|--help)
        _run "$bin" "$@" ;;
      *)
        _run "$bin" bake --out "$tree" "$@"
        _say "bake tree: $tree — verify with: obc bake verify" ;;
    esac

# Run the web map builder at http://localhost:8000 (bootstraps the venv, obc-pack,
# and the frontend on first run). Extra args pass through (e.g. --no-browser).
# Run the web map builder on :8000 (bootstraps venv/frontend on first run)
web *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    cd "$OBC_ROOT"
    export OBC_PACK_BIN="$OBC_ROOT/target/release/obc-pack"
    if [[ ! -x .venv/bin/python ]]; then
      _say "creating .venv + installing packer deps…"
      _run python3 -m venv .venv
      _run .venv/bin/pip install -q --upgrade pip
      _run .venv/bin/pip install -q -r builder/requirements.txt
    fi
    if [[ "${1:-}" == preview-source ]]; then
      shift
      (( $# == 0 )) || { _err "usage: obc web preview-source"; exit 1; }
      _say "downloading the fixed Freiburg-regbez source for the Teningen schema lab…"
      _run .venv/bin/python -m builder.server.schema_preview --download-source
      exit 0
    fi
    [[ -x "$OBC_PACK_BIN" ]] || { _say "building obc-pack…"; ( cd "$OBC_ROOT" && _run cargo build --release -p obc-pack ); }
    [[ -d builder/app/node_modules ]] || { _say "installing frontend dependencies…"; ( cd builder/app && _run npm ci ); }
    if [[ ! -f builder/app/src/lib/convert/pkg/obc_web_convert_bg.wasm || \
          ! -f builder/app/src/lib/assemble/pkg/obc_web_assemble_bg.wasm || \
          ! -f builder/app/src/lib/skin/pkg/obc_skin_preview_bg.wasm ]]; then
      _say "building the wasm bridges…"; ( cd builder/app && _run npm run build:wasm )
    fi
    # Always rebuild this small local bundle: tools/obc.local is runtime state,
    # but a source checkout must never keep serving yesterday's platform adapter.
    _say "building the maintainer frontend…"; ( cd builder/app && _run npm run build )
    _run .venv/bin/python -m builder.server "$@"

# Run the desktop app (Tauri + the shared published-cell frontend). The Rust side
# embeds the built frontend. Opts: dev (live reload against Vite), build (compile
# only, don't open the window).
#   obc desktop         obc desktop dev        obc desktop build
# The desktop app consumes published cells and no longer links the packer or GEOS.
# `dev` drops `custom-protocol`, the feature that embeds the frontend, so the window
# follows Vite instead.
# Build & run the desktop app. Opts: dev (live-reload) build (compile only)
desktop *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    mode=run
    for o in "$@"; do case "$o" in
      dev)              mode=dev ;;
      build|build-only) mode=build ;;
      *) _err "unknown desktop option: '$o'  (want: dev build)"; exit 1 ;;
    esac; done
    fe="$OBC_ROOT/builder/app"
    [[ -d "$fe/node_modules" ]] || { _say "installing frontend deps…"; ( cd "$fe" && _run npm ci ); }
    # All three wasm bridges are imported by the app: GPX↔OBCR conversion, cell
    # assembly, and the live skin preview. Build them before type-checking or bundling.
    if [[ ! -f "$fe/src/lib/convert/pkg/obc_web_convert_bg.wasm" || \
          ! -f "$fe/src/lib/assemble/pkg/obc_web_assemble_bg.wasm" || \
          ! -f "$fe/src/lib/skin/pkg/obc_skin_preview_bg.wasm" ]]; then
      _say "building the wasm bridges…"; ( cd "$fe" && _run npm run build:wasm )
    fi
    if [[ "$mode" == dev ]]; then
      # `custom-protocol` is a default feature here, which is what makes plain
      # `cargo run` embed dist/desktop; opt out of it and the window follows Vite.
      _say "starting Vite (desktop mode) on :5173 — leave it running, then this window follows it"
      ( cd "$fe" && npm run dev -- --mode desktop & )
      cd "$OBC_ROOT/apps/obc-desktop"; _run cargo run --no-default-features
    else
      _say "building the desktop frontend bundle…"
      ( cd "$fe" && _run npm run build:desktop )
      cd "$OBC_ROOT/apps/obc-desktop"
      [[ "$mode" == build ]] && { _run cargo build --release; _say "built: $PWD/target/release/obc-desktop"; exit 0; }
      _run cargo run --release
    fi

# Serve the static hosted tier — the no-backend site (phase C of #894), as deployed.
# Builds and serves it on :4173. Args: [PORT]. A catalog.json is the bakery's
# output; without one the site says so and shows no coverage — that is OBCC_Spec.md
# §7 refusing a manifest it has not got, not a bug.
# Point it at a real one with OBC_CATALOG_URL=… (the deploy passes the same value as
# VITE_CATALOG_URL from a repository variable — .github/workflows/deploy-site.yml).
# Two deliberate differences from the deploy: this mounts the builder at the server
# root rather than at /builder/ (nothing else is being served beside it), and it leaves
# VITE_SITE_BASE unset, so the Docs/Home links point at the published site instead of
# at siblings that aren't here.
# Build & serve the static hosted tier (no backend) on :4173. Args: [PORT]
site *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    port="${1:-4173}"
    fe="$OBC_ROOT/builder/app"
    [[ -d "$fe/node_modules" ]] || { _say "installing frontend deps…"; ( cd "$fe" && _run npm ci ); }
    if [[ ! -f "$fe/src/lib/convert/pkg/obc_web_convert_bg.wasm" || \
          ! -f "$fe/src/lib/assemble/pkg/obc_web_assemble_bg.wasm" || \
          ! -f "$fe/src/lib/skin/pkg/obc_skin_preview_bg.wasm" ]]; then
      _say "building the wasm bridges…"; ( cd "$fe" && _run npm run build:wasm )
    fi
    _say "building the static web tier…"
    ( cd "$fe" && export VITE_CATALOG_URL="${OBC_CATALOG_URL:-}" && _run npm run build:web )
    cd "$OBC_ROOT"
    if [[ ! -x .venv/bin/python ]]; then
      _say "creating .venv + installing packer deps…"
      _run python3 -m venv .venv
      _run .venv/bin/pip install -q --upgrade pip
      _run .venv/bin/pip install -q -r builder/requirements.txt
    fi
    # The Geofabrik index the picker draws. The FastAPI host computes it per request;
    # a site with no backend needs it as a file — the deploy runs this same module.
    _run .venv/bin/python -m builder.server.static_data --out "$fe/dist/web/data"
    _say "serving http://localhost:$port  (Ctrl-C to stop)"
    # Absolute interpreter + `--directory`, not `cd` + a relative `.venv/bin/python`: the relative
    # form resolved against the *serving* directory and vanished the moment we left the repo root.
    _run "$OBC_ROOT/.venv/bin/python" -m http.server "$port" --directory "$fe/dist/web"

# ── Host workspace chores ────────────────────────────────────────────────────

# Build the host workspace (simulator + shared crates + packer).
build:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    cd "$OBC_ROOT"; _run cargo build --release

# Run the host test suite. Extra args pass through (e.g. -p obc-pack).
test *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    cd "$OBC_ROOT"; _run cargo test "$@"

# The workspace excludes three crates, and rustfmt walks up from each file to find its
# own manifest — so this is a FOUR-step and the fmt CI guard fails if a leg is skipped.
# Format everything: the workspace + board crate + bootloader + desktop app (four-step).
fmt:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    cd "$OBC_ROOT"
    _run cargo fmt --all
    _run cargo fmt --manifest-path firmware/obc-fw-nrf54l/Cargo.toml
    _run cargo fmt --manifest-path firmware/obc-boot/Cargo.toml
    _run cargo fmt --manifest-path apps/obc-desktop/Cargo.toml

# Render benchmark + pixel-hash tripwire. Args: (none) | check | write.
bench *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    cd "$OBC_ROOT"
    case "${1:-}" in
      check) _run cargo run -p obc-bench --release -- --check host/obc-bench/hashes.txt ;;
      write) _run cargo run -p obc-bench --release -- --write-hashes host/obc-bench/hashes.txt ;;
      *)     _run cargo run -p obc-bench --release ;;
    esac

# Confirm the shared stack still compiles for the device target (no board crate).
check-device:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    cd "$OBC_ROOT"; _run cargo build -p obc-app --target thumbv8m.main-none-eabihf

# Run the CI rust gates locally — "will CI pass?" before you push. Mirrors the required
# `ci` job (fmt/clippy/test+bench/device/docs; board legs if a RISC-V gcc is present;
# deny/wasm if cargo-deny/trunk are installed). Filter to a subset, e.g.:
#   obc check fmt         obc check test         obc check board docs
check *args:
    #!/usr/bin/env bash
    set -uo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    sel=("$@"); (( ${#sel[@]} )) || sel=(fmt clippy test device docs board frontend deny wasm)
    want() { local x; for x in "${sel[@]}"; do [[ "$x" == "$1" ]] && return 0; done; return 1; }
    FAILED=(); PASSED=(); SKIPPED=()
    step() { local label="$1"; shift; printf '\n'; _say "▶ $label"
             if _run "$@"; then PASSED+=("$label"); else _err "$label FAILED"; FAILED+=("$label"); fi; }
    cd "$OBC_ROOT"
    if want fmt; then
      step "fmt (workspace)"   cargo fmt --all --check
      step "fmt (board crate)" cargo fmt --check --manifest-path firmware/obc-fw-nrf54l/Cargo.toml
      step "fmt (bootloader)"  cargo fmt --check --manifest-path firmware/obc-boot/Cargo.toml
      step "fmt (desktop app)" cargo fmt --check --manifest-path apps/obc-desktop/Cargo.toml
    fi
    want clippy && step "clippy (workspace, all-targets/features)" \
      cargo clippy --workspace --all-targets --all-features --locked -- -D warnings
    if want test; then
      step "test (workspace, all features)" cargo test --workspace --all-features --locked
      step "bench pixel-hash tripwire" cargo run -p obc-bench --release --locked -- --check host/obc-bench/hashes.txt
    fi
    want device && step "device build (obc-app @ thumbv8m)" \
      cargo build -p obc-app --target thumbv8m.main-none-eabihf --locked
    if want board; then
      if ensure_riscv 2>/dev/null; then
        pushd "$OBC_ROOT/firmware/obc-fw-nrf54l" >/dev/null
        step "board clippy (default)"        cargo clippy --locked -- -D warnings
        step "board clippy (debug-uart)"     cargo clippy --locked --features debug-uart -- -D warnings
        step "board build (default, release)" cargo build --release --locked
        step "board clippy (ble)"            cargo clippy --locked --no-default-features --features ble -- -D warnings
        step "board build (ble, release)"    cargo build --release --locked --no-default-features --features ble
        popd >/dev/null
      else _warn "skip board gates — no RISC-V gcc (obc doctor --install)"; SKIPPED+=("board"); fi
    fi
    if want frontend; then
      if command -v npm >/dev/null 2>&1; then
        fe="$OBC_ROOT/builder/app"
        pushd "$fe" >/dev/null
        [[ -d node_modules ]] || step "frontend deps (npm ci)" npm ci
        # Not optional: the TS wrapper imports the generated bindings, so svelte-check
        # and the byte-identity drift guard both fail without the module present. CI
        # gets all three packages from the `wasm-bridges` job; locally we build them.
        step "wasm bridges"          npm run build:wasm
        step "frontend svelte-check" npm run check
        step "frontend vitest"       npm test
        step "frontend builds (dev + web + desktop)" npm run build:all
        popd >/dev/null
      else _warn "skip frontend — npm not installed"; SKIPPED+=("frontend"); fi
    fi
    if want deny; then
      if command -v cargo-deny >/dev/null 2>&1; then
        step "deny (workspace)"   cargo deny --manifest-path "$OBC_ROOT/Cargo.toml" --all-features check --config "$OBC_ROOT/deny.toml"
        step "deny (board crate)" cargo deny --manifest-path "$OBC_ROOT/firmware/obc-fw-nrf54l/Cargo.toml" --all-features check --config "$OBC_ROOT/deny.toml"
      else _warn "skip deny — cargo-deny not installed (cargo install cargo-deny)"; SKIPPED+=("deny"); fi
    fi
    if want wasm; then
      if command -v trunk >/dev/null 2>&1; then step "wasm (obc-sim → wasm)" trunk build --config "$OBC_ROOT/docs/Trunk.toml"
      else _warn "skip wasm — trunk not installed (cargo install trunk)"; SKIPPED+=("wasm"); fi
    fi
    want docs && step "docs link check" python3 "$OBC_ROOT/docs/build_docs.py" --check-links
    printf '\n'; _say "check summary"
    (( ${#PASSED[@]} ))  && _ok   "passed:  ${PASSED[*]}"
    (( ${#SKIPPED[@]} )) && _warn "skipped: ${SKIPPED[*]}"
    if (( ${#FAILED[@]} )); then _err "failed:  ${FAILED[*]}"; exit 1; fi
    _ok "all run gates passed"

# ── Meta ─────────────────────────────────────────────────────────────────────

# Check your toolchain and report what's missing. Add --install to fix what it can
# (rustup targets, just, probe-rs, the venv, replication client, and GEOS / RISC-V gcc via scripts/).
doctor *args:
    #!/usr/bin/env bash
    set -uo pipefail
    source "{{lib}}"; obc_init
    install=0; for a in "$@"; do [[ "$a" == --install ]] && install=1; done
    _say "OpenBikeComputer toolchain check"
    MISSING=()
    ck() { # ck <key> <label> <test> [hint]
      if eval "$3" >/dev/null 2>&1; then _ok "$2"; else _err "$2"; [[ -n "${4:-}" ]] && _hint "$4"; MISSING+=("$1"); fi
    }
    ck cargo    "rust / cargo"              'command -v cargo'  'install rustup: https://rustup.rs'
    ck just     "just"                      'command -v just'   'obc doctor --install'
    ck thumbv8m "device target (thumbv8m)"  'rustup target list --installed | grep -q thumbv8m.main-none-eabihf' 'obc doctor --install'
    ck wasm     "wasm target (docs demo)"   'rustup target list --installed | grep -q wasm32-unknown-unknown'     'obc doctor --install'
    ck geos     "GEOS (obc-pack, workspace)" '[[ -f "$HOME/.obc-geos-env.sh" ]] && { source "$HOME/.obc-geos-env.sh"; command -v geos-config; }' 'obc doctor --install (builds GEOS ≥3.14 from source)'
    ck osmium   "Osmium (planet sharding)"   'command -v osmium' 'install osmium-tool with your system package manager'
    ck riscv    "RISC-V gcc (board FLPR)"   'command -v riscv64-elf-gcc || command -v riscv-none-elf-gcc || command -v riscv64-unknown-elf-gcc || { [[ -n "${RISCV_GCC:-}" && -x "${RISCV_GCC:-/nonexistent}" ]]; }' 'obc doctor --install (fetches an xPack toolchain)'
    ck probe    "probe-rs (flashing)"       'command -v probe-rs' 'obc doctor --install'
    ck node     "node + npm (web builder)"  'command -v node && command -v npm' 'install Node 22+ (system package — needs sudo)'
    ck venv     "python venv (web builder)" '[[ -x "$OBC_ROOT/.venv/bin/python" ]]' 'obc doctor --install (or run obc web)'
    ck replication "OSM replication client" 'command -v pyosmium-up-to-date || [[ -x "$OBC_ROOT/.venv/bin/pyosmium-up-to-date" ]]' 'obc doctor --install'
    m="$(_all_maps | head -n1 || true)"
    if [[ -n "$m" ]]; then _ok "default sim map → ${m##*/}"
    elif [[ -f "$OBC_ROOT/apps/obc-sim/assets/grimsel.obcm" ]]; then _ok "default sim map → bundled grimsel.obcm"
    else _warn "no .obcm found — build one with 'obc pack' or 'obc web', or drop one in the repo root"; fi

    if (( ! install )); then
      (( ${#MISSING[@]} )) && { printf '\n'; _hint "re-run with --install to fix: ${MISSING[*]}"; }
      exit 0
    fi
    (( ${#MISSING[@]} )) || { printf '\n'; _ok "nothing to install"; exit 0; }
    printf '\n'; _say "installing: ${MISSING[*]}"
    for k in "${MISSING[@]}"; do case "$k" in
      thumbv8m) _run rustup target add thumbv8m.main-none-eabihf ;;
      wasm)     _run rustup target add wasm32-unknown-unknown ;;
      just)     _run cargo install just ;;
      probe)    _run cargo install probe-rs-tools --locked ;;
      riscv)    _run bash "$OBC_TOOLS/install-riscv.sh" ;;
      geos)     _run bash "$OBC_TOOLS/install-geos.sh" ;;
      venv)     _run python3 -m venv "$OBC_ROOT/.venv" && _run "$OBC_ROOT/.venv/bin/pip" install -q -r "$OBC_ROOT/builder/requirements.txt" ;;
      replication)
        [[ -x "$OBC_ROOT/.venv/bin/python" ]] || _run python3 -m venv "$OBC_ROOT/.venv"
        _run "$OBC_ROOT/.venv/bin/pip" install -q -r "$OBC_ROOT/tools/requirements-bake.txt" ;;
      cargo)    _err "install Rust yourself: https://rustup.rs" ;;
      node)     _err "install Node 22+ via your system package manager (needs sudo)" ;;
      osmium)   _err "install osmium-tool via your system package manager" ;;
    esac; done
    printf '\n'; _say "done — re-run 'obc doctor' to confirm"

# One-time: link `obc` into ~/.local/bin and enable bash completion.
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    # `setup` edits $HOME, not the repo, and the writes below bypass `_run` — so honour the dry-run
    # switch explicitly rather than cheerfully reporting changes it already made.
    if [[ -n "${OBC_DRY_RUN:-}" ]]; then
      _say "dry run — would link ~/.local/bin/obc → $OBC_TOOLS/obc and wire completion into your shell rc"
      exit 0
    fi
    # A git worktree has its own tools/ — linking from one pins `obc` to a checkout that is usually
    # temporary. Point at the main working tree instead, whichever directory you ran this from.
    main_root="$(git -C "$OBC_ROOT" worktree list --porcelain 2>/dev/null | awk '/^worktree /{print $2; exit}')"
    tools="$OBC_TOOLS"
    if [[ -n "$main_root" && "$main_root" != "$OBC_ROOT" && -x "$main_root/tools/obc" ]]; then
      _warn "$OBC_ROOT is a linked worktree — linking from the main checkout $main_root instead"
      tools="$main_root/tools"
    fi
    mkdir -p "$HOME/.local/bin"
    ln -sf "$tools/obc" "$HOME/.local/bin/obc"
    _ok "linked ~/.local/bin/obc → $tools/obc"
    # Completion is written for bash, but zsh runs it fine behind `bashcompinit` — and a zsh user
    # with no ~/.bashrc used to get a cheerful "wired in" for a file their shell never reads. Wire
    # whichever rc files actually exist, plus the one $SHELL implies.
    comp="$tools/obc.bash"; rcs=()
    [[ -f "$HOME/.bashrc" || "$SHELL" == */bash ]] && rcs+=("$HOME/.bashrc")
    [[ -f "$HOME/.zshrc"  || "$SHELL" == */zsh  ]] && rcs+=("$HOME/.zshrc")
    (( ${#rcs[@]} )) || rcs=("$HOME/.bashrc")
    for rc in "${rcs[@]}"; do
      # Strip any prior obc-completion block first (so a relocated tools/ dir self-heals), then add.
      if [[ -f "$rc" ]]; then
        grep -vE 'OpenBikeComputer `obc` completion|/obc\.bash"|bashcompinit && bashcompinit' "$rc" > "$rc.obc-tmp" || true
        mv "$rc.obc-tmp" "$rc"
      fi
      { printf '\n# OpenBikeComputer `obc` completion\n'
        # zsh needs bash-completion emulation before `complete -F` means anything.
        [[ "$rc" == *.zshrc ]] && printf 'autoload -Uz bashcompinit && bashcompinit\n'
        printf '[ -f "%s" ] && source "%s"\n' "$comp" "$comp"
      } >> "$rc"
      _ok "completion wired into ${rc/#$HOME/~} → $comp"
    done
    case ":$PATH:" in *":$HOME/.local/bin:"*) : ;;
      *) _warn "~/.local/bin is not on PATH — add it in ${rcs[0]/#$HOME/~}";; esac
    _say "open a new shell (or: source ${rcs[0]/#$HOME/~}) to pick up 'obc' + completion"
