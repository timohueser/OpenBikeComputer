# OpenBikeComputer dev tasks — invoke with `obc <task>` (see `obc setup`), or
# `just --justfile tools/justfile <task>`. This lives in tools/; OBC_ROOT is its parent
# (the repo root). Personal defaults (map/gpx/preset/toolchain paths) live in a gitignored
# `tools/obc.local` — copy tools/obc.local.example and edit. `OBC_DRY_RUN=1 obc …` prints
# the underlying commands without running them.
# The test routes and proportional verification are defined in docs/testing.md.

set shell := ["bash", "-euo", "pipefail", "-c"]
set positional-arguments := true

export OBC_ROOT  := parent_directory(justfile_directory())   # the repo root
export OBC_TOOLS := justfile_directory()                     # this tools/ dir
lib := justfile_directory() / "obc-dev.sh"

# List the available tasks.
[private]
default *args:
    @python3 '{{OBC_TOOLS}}/tasks.py' --justfile '{{justfile()}}' "$@"

# ── Deployed services ────────────────────────────────────────────────────────

#
#
# ── Simulator ────────────────────────────────────────────────────────────────

# Common forms: `obc fixtures list`, `obc fixtures show grimsel`,
# `obc fixtures sync sim`, `obc fixtures verify test`.
# List, inspect, download, verify and prune the content-addressed fixture registry.
[group('maps')]
fixtures *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    cd "$OBC_ROOT"
    _run python3 "$OBC_TOOLS/fixtures.py" "$@"

# Run a named fixture scenario or an explicit map (always --physical). With no
# arguments this runs the canonical `grimsel` scenario.
# Args: [SCENARIO|MAP.obcm] [TRACK.gpx] [-- sim flags].
# Explicit MAP defaults to $OBC_MAP or the newest .obcm in the repo root; TRACK
# to $OBC_GPX. Named scenarios are the reproducible path. Pass `none` as the
# explicit track to run without GPS.
# Run the simulator on a map + GPX, always at physical size. Args: [MAP] [TRACK.gpx] [-- sim flags]
[group('run')]
sim *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    split_args "$@"
    scenario="${_POS[0]:-grimsel}"
    scenario_args=()
    mapf="" gpxf=""
    if [[ -n "$scenario" ]] && python3 "$OBC_TOOLS/fixtures.py" exists "$scenario"; then
        (( ${#_POS[@]} <= 1 )) || {
            _err "a named scenario already supplies its track; pass simulator flags after --"
            exit 1
        }
        _run python3 "$OBC_TOOLS/fixtures.py" sync "$scenario"
        resolved="$(python3 "$OBC_TOOLS/fixtures.py" resolve --no-sync "$scenario")"
        while IFS=$'\t' read -r kind value; do
            case "$kind" in
              map)     mapf="$value" ;;
              gpx)     gpxf="$value" ;;
              routes_dir) scenario_args+=(--routes-dir "$value") ;;
              tracks_dir) scenario_args+=(--tracks-dir "$value") ;;
              arg)     scenario_args+=("$value") ;;
              *) _err "fixture resolver returned unknown field '$kind'"; exit 1 ;;
            esac
        done <<< "$resolved"
        cmd=(cargo run --release -p obc-sim -- "$mapf" --physical)
    else
      gpxf="$(resolve_gpx "${_POS[1]:-}")"
      mapf="$(resolve_map "${_POS[0]:-}")" || exit 1
      cmd=(cargo run --release -p obc-sim -- "$mapf" --physical)
    fi
    [[ -n "$gpxf" && "$gpxf" != none ]] && cmd+=(--gpx "$gpxf")
    (( ${#scenario_args[@]} )) && cmd+=("${scenario_args[@]}")
    (( ${#_EXTRA[@]} )) && cmd+=("${_EXTRA[@]}")
    cd "$OBC_ROOT"; _run "${cmd[@]}"

# Render a UI frame from firmware/ui-frames.toml through the headless simulator. A name or a
# glob renders those frames; `--list [PATTERN]` answers which frames exist and what screen each
# one reaches, so nobody has to open the table. `--vs REF` renders the frame here and at REF and
# prints the changed share first, so an unchanged frame needs no picture at all.
#   obc shot routemenu          obc shot 'statistics*'      obc shot --list map
#   obc shot map --vs origin/develop
#   obc shot --all [DIR]        obc shot --check [DIR]      obc shot --accept [NAMES]
# Render one UI frame, a family, or the whole sweep. Args: [NAME|GLOB] [--list|--vs|--all|--check]
[group('run')]
shot *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    cd "$OBC_ROOT"
    export PYTHONPATH="$OBC_ROOT/firmware/tools"
    _run python3 -m ui_frames "$@"

# ── Board firmware ───────────────────────────────────────────────────────────

# Requires typing FORMAT unless --yes is passed. Use --serial when more than one device is attached.
# Destructively initialize the card in one USB-connected device as an empty flat store. Args: [--serial SERIAL] [--yes]
[group('device')]
format-card *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    cd "$OBC_ROOT"
    _run cargo run --release -p obc-usb --bin obc-format-card -- "$@"

# Build & flash the board. Opts (space-separated): debug-uart  synth  build.
# The radio and the USB plane are in every image (#889, #1530) — there is nothing to turn on.
# e.g.  obc flash            (real sensors)   obc flash debug-uart
#       obc flash build      (compile only, no flash)
# Build & flash the board. Opts: debug-uart synth build (e.g. obc flash debug-uart)
[group('device')]
flash *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_riscv || exit 1
    du=0 synth=0 action=run
    for o in "$@"; do case "$o" in
      debug-uart|du)      du=1 ;;
      synth)              synth=1 ;;
      build|build-only)   action=build ;;
      *) _err "unknown flash option: '$o'  (want: debug-uart synth build)"; exit 1 ;;
    esac; done
    [[ "$action" == run ]] && { ensure_probe || exit 1; }
    a=(); feats=()
    (( du ))    && feats+=(debug-uart)
    (( synth )) && feats+=(synth)
    (( ${#feats[@]} )) && a+=(--features "$(IFS=,; echo "${feats[*]}")")
    cd "$OBC_ROOT/firmware/obc-fw-nrf54l"
    # `${a[@]+"${a[@]}"}`, not `"${a[@]}"`: macOS ships bash 3.2, where expanding an EMPTY array
    # under `set -u` is an "unbound variable" error. That is the no-options case — i.e. plain
    # `obc flash`, now the common one since the USB plane stopped being a feature.
    _run cargo "$action" --release ${a[@]+"${a[@]}"}

# Build & flash the 32 KB bootloader (obc-boot). Flash it ONCE: probe-rs writes ELFs at their
# linked addresses, so the app (linked at 0x8000) never touches it afterwards. Opts: rtt (defmt
# over RTT — a debug aid, NOT the shipping shape the 32 KB size guard is measured on), build
# (compile only). Needs no RISC-V toolchain: the bootloader keeps the COM wave alive in software,
# not on the FLPR.
# Build & flash the bootloader — once. Opts: rtt (defmt logging) build (compile only)
[group('device')]
flash-boot *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    rtt=0 action=run
    for o in "$@"; do case "$o" in
      rtt)              rtt=1 ;;
      build|build-only) action=build ;;
      *) _err "unknown flash-boot option: '$o'  (want: rtt build)"; exit 1 ;;
    esac; done
    [[ "$action" == run ]] && { ensure_probe || exit 1; }
    a=()
    (( rtt )) && a+=(--features rtt)
    cd "$OBC_ROOT/firmware/obc-boot"
    # Empty-array expansion under bash 3.2 + `set -u` is an error — same guard as `flash`.
    _run cargo "$action" --release ${a[@]+"${a[@]}"}
    # `if`, not a trailing `[[ … ]] && …`: as the recipe's LAST statement, a false test would be the
    # script's exit status, so `flash-boot build` would "fail" after building perfectly.
    if [[ "$action" == run ]]; then
      _say "power-cycle the DK: one short LED0 blink (bootloader), then the app"
    fi

# Drive a debug-uart board over VCOM (obc-usb-host). A GPX is optional: without one, the feeder's
# fixed-location panel can stream an entered or searched coordinate instead.
# Args: [TRACK.gpx] [-- --port TTY | --baud N | --list].
# Open the debug-uart GPS feeder. Args: [TRACK.gpx] [-- --port TTY | --list]
[group('device')]
uart *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    split_args "$@"
    cd "$OBC_ROOT"
    # `--list` just enumerates serial ports; no GPX needed.
    for e in "${_EXTRA[@]:-}"; do [[ "$e" == --list ]] && { _run cargo run --release -p obc-usb-host -- --list; exit 0; }; done
    gpxf="$(resolve_gpx "${_POS[0]:-}")"
    cmd=(cargo run --release -p obc-usb-host --)
    [[ -n "$gpxf" && "$gpxf" != none ]] && cmd+=(--gpx "$gpxf")
    (( ${#_EXTRA[@]} )) && cmd+=("${_EXTRA[@]}")
    _run "${cmd[@]}"

# Bench control in one step: flash the debug-uart firmware, then open the feeder over
# VCOM. Args: [TRACK.gpx]. Without a GPX, use its fixed-location panel. Flashes with
# `probe-rs download` (returns cleanly,
# no RTT), then runs the feeder TUI in the foreground. Want defmt logs too? Run
# `obc rtt` in a second terminal.
# One step: flash debug-uart firmware, then open the GPS feeder. Args: [TRACK.gpx]
[group('device')]
debug *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_riscv || exit 1; ensure_probe || exit 1
    gpx="${1:-}"
    elf="$OBC_ROOT/firmware/obc-fw-nrf54l/target/thumbv8m.main-none-eabihf/release/obc-fw-nrf54l"
    _say "building debug-uart firmware…"
    ( cd "$OBC_ROOT/firmware/obc-fw-nrf54l" && _run cargo build --release --features debug-uart )
    _say "flashing over J-Link…"
    _run python3 "$OBC_TOOLS/board.py" download "$elf"
    _run python3 "$OBC_TOOLS/board.py" reset
    _say "flashed — starting the feeder (Ctrl-C to stop)…"
    just --justfile '{{justfile()}}' uart ${gpx:+"$gpx"}

# Uses the shared Cargo runner.
# Board diagnostics or a direct operation on an exact ELF. Args: doctor | run ELF | download ELF | attach ELF | reset [--probe VID:PID:SERIAL]
[group('device')]
board *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    _run python3 "$OBC_TOOLS/board.py" "$@"

# Pass the matching ELF when using another build.
# Attach RTT without rebuilding or flashing. Args: [ELF] [--probe VID:PID:SERIAL] [--log FILE]
[group('device')]
rtt *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_probe || exit 1
    elf="$OBC_ROOT/firmware/obc-fw-nrf54l/target/thumbv8m.main-none-eabihf/release/obc-fw-nrf54l"
    if [[ $# -gt 0 && "$1" != --* ]]; then elf="$(_abspath "$1")"; shift; fi
    [[ -f "$elf" ]] || { _err "no matching board ELF — pass it to: obc rtt ELF"; exit 1; }
    _run python3 "$OBC_TOOLS/board.py" attach "$elf" "$@"

# ── Map packing & the web builder ────────────────────────────────────────────

# Pack an OSM extract into a .obcm map, and print the preset and the path it wrote — so
# `obc sim <that file>` opens it next. Args: <region.osm.pbf> [config.json] [out.obcm]
# [-- --bbox W,S,E,N | --chunk-size N | --no-land]. The config defaults to
# builder/presets/schema.json — the one shipped schema; the output defaults to
# <region>.obcm in the repo root. Packer flags go after `--`; cut a big extract down
# to one region with `-- --bbox W,S,E,N`. A region wider than 10,000 km² is refused
# with the size it measured, because a look is not worth a half-hour pack.
# Pack an OSM extract to a .obcm map. Args: <region.osm.pbf> [preset.json] [out.obcm]
[group('maps')]
pack *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    split_args "$@"
    pbf="${_POS[0]:-}"
    [[ -n "$pbf" ]] || { _err "usage: obc pack <region.osm.pbf> [preset.json] [out.obcm]"; exit 1; }
    pbf="$(_abspath "$pbf")"
    preset="${_POS[1]:-${OBC_PRESET:-$OBC_ROOT/builder/presets/schema.json}}"; preset="$(_abspath "$preset")"
    [[ -f "$preset" ]] || {
        _err "no preset at $preset — packer flags belong after --, as in: obc pack $pbf -- --bbox W,S,E,N"
        exit 1
    }
    out="${_POS[2]:-}"
    if [[ -n "$out" ]]; then out="$(_abspath "$out")"
    else base="$(basename "$pbf")"; base="${base%.osm.pbf}"; base="${base%.pbf}"; out="$OBC_ROOT/${base}.obcm"; fi
    ( cd "$OBC_ROOT" && _run cargo build --release -p obc-pack )
    _say "preset $preset"
    cmd=("$OBC_ROOT/target/release/obc-pack" "$pbf" "$preset" "$out")
    (( ${#_EXTRA[@]} )) && cmd+=("${_EXTRA[@]}")
    _run "${cmd[@]}"
    _say "wrote $out"

# Name a binary artefact's format from its magic bytes and print a summary of what is inside:
# a map's bounding box, section table and level-of-detail ladder, a route's points and
# waypoints, a trip's stages, a terrain container's grid, a card image's store and objects,
# or the persisted settings. `--json` prints the same facts for a machine. It reads only, and
# a damaged file gives a report of the damage and a non-zero exit.
#   obc inspect grimsel.obcm            obc inspect routes/tour.obcr --json
#   obc inspect card.img                obc inspect obc-settings.bin
# Name a binary artefact and summarise it. Args: <FILE> [--json]
[group('maps')]
inspect *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    ( cd "$OBC_ROOT" && _run cargo build --release --quiet -p obc-inspect )
    _run "$OBC_ROOT/target/release/obc-inspect" "$@"

# The one guarded way to delete from the R2 maps bucket: cells, terrain objects,
# reference tiles and strays alike. It reads the bucket and the credential from
# tools/obc.local, the same variables `obc bake publish` uses.
#
#   obc r2 rm cell-catalog/cells/fine/1204/1052.<sha256>.obcm   # the plan, and no more
#   obc r2 rm --prefix reference/v1/16/3410
#   obc r2 rm <key> --apply --reason "bad ingest" --confirm "<the plan's own string>"
#
# A published cell, preview or index carries the digest of its bytes in its key. `rm`
# prints what it would delete, with each object's size and age, and stops. `--apply` takes
# back the confirmation that plan printed — a count and a digest of the whole key list —
# so neither a stale command line nor a bucket that moved under it deletes anything.
# The catalogue root, any object the live catalogue names (cells included, through their
# band indexes), the reference index and `removed.jsonl` each need `--i-mean-it <key>` on
# top. A catalogue this cannot read is a refusal. Every removal is appended to
# `removed.jsonl` at the bucket root.
# Delete objects from the R2 maps bucket, with a plan first. Args: rm <KEY>… | rm --prefix P
[group('maps')]
r2 *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    cd "$OBC_ROOT"
    _run python3 "$OBC_TOOLS/r2.py" "$@"

# Bake the published cell catalog. `obc bake` processes every regions.toml entry;
# positional ids narrow it (`obc bake europe/austria --force`). Output goes to
# $OBC_BAKE_TREE (default ~/obc-bake). `verify` and `publish` use that same tree
# automatically, while an explicit tree remains available as their first argument:
#
#   obc bake europe/germany/baden-wuerttemberg
#   obc bake terrain --sources /tmp/dem   # the OBCT band, own revision track
#   obc bake landmarks europe/switzerland # capture + compile, own revision track
#   obc bake verify
#   obc bake publish                  # plan only
#   obc bake publish --target r2      # upload content first, catalog root last
#   obc bake clean-r2                 # dry-run removal of the complete maps bucket
#   obc bake clean-r2 --apply         # purge that bucket before a fresh publish
#
# Publish reads its public URL and R2 credentials from tools/obc.local or the
# environment. The clean command verifies the configured bucket by reading the
# live catalog at OBC_R2_PREFIX, then deletes every object in that bucket.
# Bake, verify, publish, or replace R2 objects using $OBC_BAKE_TREE
[group('maps')]
bake *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    if [[ -z "${OBC_PYOSMIUM_UP_TO_DATE:-}" && -x "$OBC_ROOT/.venv/bin/pyosmium-up-to-date" ]]; then
      export OBC_PYOSMIUM_UP_TO_DATE="$OBC_ROOT/.venv/bin/pyosmium-up-to-date"
    fi
    export OBC_LANDMARK_CAPTURE_TOOL="${OBC_LANDMARK_CAPTURE_TOOL:-$OBC_ROOT/tools/landmark_capture.py}"
    ( cd "$OBC_ROOT" && _run cargo build --release -p obc-bake )
    bin="$OBC_ROOT/target/release/obc-bake"
    tree="${OBC_BAKE_TREE:-$HOME/obc-bake}"
    # The terrain stage reads the reference archive for its crest lifts. A run that forgets
    # `--reference` re-bakes every lifted cell without lifts, so obc.local names the archive
    # once and every bake passes it unless the command line already does.
    reference=()
    if [[ -n "${OBC_REFERENCE_ARCHIVE:-}" ]]; then
      case " $* " in *" --reference "*) ;; *) reference=(--reference "$OBC_REFERENCE_ARCHIVE") ;; esac
    fi
    case "${1:-}" in
      verify)
        shift
        verify_tree="$tree"
        if (( $# )) && [[ "$1" != -* ]]; then verify_tree="$1"; shift; fi
        _run "$bin" verify "$verify_tree" "$@" ;;
      publish)
        shift
        publish_tree="$tree"
        if (( $# )) && [[ "$1" != -* ]]; then publish_tree="$1"; shift; fi
        maps_base="${OBC_MAPS_BASE_URL:-}"
        if [[ -z "$maps_base" && -n "${OBC_CATALOG_URL:-}" ]]; then
          case "$OBC_CATALOG_URL" in
            */catalog.json) maps_base="${OBC_CATALOG_URL%/catalog.json}" ;;
            *)
              _err "OBC_CATALOG_URL must end in /catalog.json: $OBC_CATALOG_URL"
              exit 1 ;;
          esac
        fi
        if [[ -z "$maps_base" ]]; then
          prefix="${OBC_R2_PREFIX:-cell-catalog}"; prefix="${prefix#/}"; prefix="${prefix%/}"
          [[ -n "$prefix" ]] || { _err "OBC_R2_PREFIX may not be empty"; exit 1; }
          export OBC_R2_PREFIX="$prefix"
          maps_base="https://maps.openbikecomputer.com/$prefix"
          _say "using production catalog base: $maps_base"
        fi
        export OBC_MAPS_BASE_URL="$maps_base"
        _run "$bin" publish "$publish_tree" "$@" ;;
      clean-r2)
        shift
        apply=0
        for arg in "$@"; do case "$arg" in
          --apply) apply=1 ;;
          *) _err "unknown clean-r2 option: '$arg'  (want: --apply)"; exit 1 ;;
        esac; done
        command -v rclone >/dev/null 2>&1 || { _err "rclone is required for R2 cleanup"; exit 1; }
        missing=()
        [[ -n "${OBC_R2_BUCKET:-}" ]] || missing+=(OBC_R2_BUCKET)
        [[ -n "${OBC_R2_ACCESS_KEY_ID:-}" ]] || missing+=(OBC_R2_ACCESS_KEY_ID)
        [[ -n "${OBC_R2_SECRET_ACCESS_KEY:-}" ]] || missing+=(OBC_R2_SECRET_ACCESS_KEY)
        [[ -n "${OBC_R2_ENDPOINT:-}" || -n "${OBC_R2_ACCOUNT_ID:-}" ]] || missing+=(OBC_R2_ACCOUNT_ID)
        if (( ${#missing[@]} )); then
          _err "missing R2 settings: ${missing[*]}"
          _hint "put them in the gitignored tools/obc.local (see tools/obc.local.example)"
          exit 1
        fi
        prefix="${OBC_R2_PREFIX:-}"; prefix="${prefix#/}"; prefix="${prefix%/}"
        [[ -n "$prefix" && "$prefix" != . ]] || {
          _err "OBC_R2_PREFIX must name the catalog prefix used to verify the bucket (for example: cell-catalog)"
          exit 1
        }
        case "/$prefix/" in
          */../*|*/./*)
            _err "unsafe OBC_R2_PREFIX '$prefix' contains a dot path segment"; exit 1 ;;
        esac
        maps_base="${OBC_MAPS_BASE_URL:-}"
        [[ -n "$maps_base" ]] || { _err "OBC_MAPS_BASE_URL is required for R2 cleanup"; exit 1; }
        maps_base="${maps_base%/}"
        [[ "$maps_base" == */"$prefix" ]] || {
          _err "OBC_MAPS_BASE_URL '$maps_base' does not end in OBC_R2_PREFIX '$prefix'"
          exit 1
        }
        endpoint="${OBC_R2_ENDPOINT:-https://${OBC_R2_ACCOUNT_ID}.r2.cloudflarestorage.com}"
        export RCLONE_CONFIG_OBCR2_TYPE=s3
        export RCLONE_CONFIG_OBCR2_PROVIDER=Cloudflare
        export RCLONE_CONFIG_OBCR2_REGION=auto
        export RCLONE_CONFIG_OBCR2_ENDPOINT="$endpoint"
        export RCLONE_CONFIG_OBCR2_ACCESS_KEY_ID="$OBC_R2_ACCESS_KEY_ID"
        export RCLONE_CONFIG_OBCR2_SECRET_ACCESS_KEY="$OBC_R2_SECRET_ACCESS_KEY"
        export RCLONE_CONFIG_OBCR2_NO_CHECK_BUCKET=true
        # The catalog prefix only: the bucket also holds the terrain reference archive
        # (host/obc-dem/reference), which is days of ingest and no part of a bake.
        root="obcr2:${OBC_R2_BUCKET}/$prefix"
        catalog="$root/catalog.json"
        _say "checking live catalog before cleanup: $catalog"
        rclone lsjson "$catalog" --stat >/dev/null || {
          _err "catalog is not readable at the configured prefix; refusing to purge it"
          exit 1
        }
        if (( apply )); then
          _warn "deleting every object under the catalog prefix: $root"
          _run rclone delete "$root" --rmdirs
          _ok "catalog prefix emptied; publish the verified bake tree immediately"
        else
          _say "dry run — review this list, then repeat with: obc bake clean-r2 --apply"
          _run rclone delete "$root" --rmdirs --dry-run
        fi ;;
      terrain)
        # The terrain artifact class, on its own revision track (OBCC_Spec.md §13). Same
        # tree as `bake`, deliberately a separate command: it needs DEM tiles and no OSM
        # extract, and it must never be a step of a schema re-bake.
        shift
        _run "$bin" terrain --out "$tree" ${reference[@]+"${reference[@]}"} "$@"
        _say "bake tree: $tree — now re-bake the cells so their ascents match: obc bake" ;;
      landmarks)
        # The landmark artifact class, on its own revision track. Capture reads live Wikidata,
        # Wikipedia and Commons — the one non-reproducible step of any bake — and is resumable, so
        # an interrupted country is continued by repeating the command.
        shift
        _run "$bin" landmarks --out "$tree" "$@"
        _say "bake tree: $tree — landmark artifacts under $tree/landmarks" ;;
      regions|check-obcm-version|help|-h|--help)
        _run "$bin" "$@" ;;
      *)
        _run "$bin" bake --out "$tree" ${reference[@]+"${reference[@]}"} "$@"
        _say "bake tree: $tree — verify with: obc bake verify" ;;
    esac

# Run the web map builder at http://localhost:8000 (bootstraps the venv, obc-pack,
# and the frontend on first run). Extra args pass through (e.g. --no-browser).
# Run the web map builder on :8000 (bootstraps venv/frontend on first run)
[group('run')]
web *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    cd "$OBC_ROOT"
    export OBC_PACK_BIN="$OBC_ROOT/target/release/obc-pack"
    if [[ ! -x .venv/bin/python ]]; then
      _say "creating .venv + installing packer deps…"
      _run python3 -m venv .venv
      _run .venv/bin/pip install -q --upgrade pip
      _run .venv/bin/pip install -q -r builder/requirements.txt
    fi
    if [[ "${1:-}" == preview-source ]]; then
      shift
      (( $# == 0 )) || { _err "usage: obc web preview-source"; exit 1; }
      _say "preparing the small reference-complete source for the Teningen schema lab…"
      _run .venv/bin/python -m builder.server.schema_preview --download-source
      exit 0
    fi
    # This is the maintainer schema host: a present binary may still predate the
    # config/parser source the editor is showing. Cargo's no-op rebuild is cheap
    # and makes the served schema and every preview use this checkout exactly.
    _say "refreshing obc-pack…"; ( cd "$OBC_ROOT" && _run cargo build --release -p obc-pack )
    [[ -d builder/app/node_modules ]] || { _say "installing frontend dependencies…"; ( cd builder/app && _run npm ci ); }
    # Generated bindings are gitignored; existence cannot prove that any bridge
    # matches its Rust source. Warm wasm-pack builds are incremental.
    _say "refreshing the wasm bridges…"; ( cd builder/app && _run npm run build:wasm )
    # Always rebuild this small local bundle: tools/obc.local is runtime state,
    # but a source checkout must never keep serving yesterday's platform adapter.
    _say "building the maintainer frontend…"; ( cd builder/app && _run npm run build )
    _run .venv/bin/python -m builder.server "$@"

# Run the desktop app (Tauri + the shared published-cell frontend). The Rust side
# embeds the built frontend. Opts: dev (live reload against Vite), build (compile
# only, don't open the window).
#   obc desktop         obc desktop dev        obc desktop build
# The desktop app consumes published cells and no longer links the packer or GEOS.
# `dev` drops `custom-protocol`, the feature that embeds the frontend, so the window
# follows Vite instead.
# Build & run the desktop app. Opts: dev (live-reload) build (compile only)
[group('run')]
desktop *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    mode=run
    for o in "$@"; do case "$o" in
      dev)              mode=dev ;;
      build|build-only) mode=build ;;
      *) _err "unknown desktop option: '$o'  (want: dev build)"; exit 1 ;;
    esac; done
    fe="$OBC_ROOT/builder/app"
    [[ -d "$fe/node_modules" ]] || { _say "installing frontend deps…"; ( cd "$fe" && _run npm ci ); }
    # All three wasm bridges are imported by the app: GPX↔OBCR conversion, cell
    # assembly, and the live skin preview. Generated bindings are gitignored;
    # existence cannot prove that any bridge matches its Rust source, so always
    # rebuild — warm wasm-pack builds are incremental.
    _say "refreshing the wasm bridges…"; ( cd "$fe" && _run npm run build:wasm )
    if [[ "$mode" == dev ]]; then
      # `custom-protocol` is a default feature here, which is what makes plain
      # `cargo run` embed dist/desktop; opt out of it and the window follows Vite.
      _say "starting Vite (desktop mode) on :5173 — leave it running, then this window follows it"
      ( cd "$fe" && npm run dev -- --mode desktop & )
      cd "$OBC_ROOT/apps/obc-desktop"; _run cargo run --no-default-features
    else
      # vite/esbuild strips types without checking them; svelte-check is what
      # fails loudly when the app drifts from a bridge's generated bindings.
      _say "type-checking the frontend…"; ( cd "$fe" && _run npm run check )
      _say "building the desktop frontend bundle…"
      ( cd "$fe" && _run npm run build:desktop )
      cd "$OBC_ROOT/apps/obc-desktop"
      [[ "$mode" == build ]] && { _run cargo build --release; _say "built: $PWD/target/release/obc-desktop"; exit 0; }
      _run cargo run --release
    fi

