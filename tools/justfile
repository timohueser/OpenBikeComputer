# Inspect documentation ownership or review source-related prose. Args: [status|check|review]
[group('docs')]
docs *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    cd "$OBC_ROOT"
    if [[ "${1:-}" == review ]]; then shift; _run python3 "$OBC_TOOLS/docs_review.py" "$@"
    elif (( $# )); then _run python3 "$OBC_TOOLS/docs_copy.py" "$@"
    else _run python3 "$OBC_TOOLS/docs_copy.py" status
    fi

# Serve the static hosted tier — the no-backend site (phase C of #894), as deployed.
# Builds and serves it on :4173. Args: [PORT]. A catalog.json is the bakery's
# output; without one the site says so and shows no coverage — that is OBCC_Spec.md
# §7 refusing a manifest it has not got, not a bug.
# Point it at a real one with OBC_CATALOG_URL=… (the deploy passes the same value as
# VITE_CATALOG_URL from a repository variable — .github/workflows/deploy-site.yml).
# Two deliberate differences from the deploy: this mounts the builder at the server
# root rather than at /builder/ (nothing else is being served beside it), and it leaves
# VITE_SITE_BASE unset, so the Docs/Home links point at the published site instead of
# at siblings that aren't here.
# Build & serve the static hosted tier (no backend) on :4173. Args: [PORT]
[group('run')]
site *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    port="${1:-4173}"
    fe="$OBC_ROOT/builder/app"
    [[ -d "$fe/node_modules" ]] || { _say "installing frontend deps…"; ( cd "$fe" && _run npm ci ); }
    # Generated bindings are gitignored; existence cannot prove that any bridge
    # matches its Rust source, so always rebuild — warm builds are incremental.
    _say "refreshing the wasm bridges…"; ( cd "$fe" && _run npm run build:wasm )
    # vite/esbuild strips types without checking them; svelte-check is what
    # fails loudly when the app drifts from a bridge's generated bindings.
    _say "type-checking the frontend…"; ( cd "$fe" && _run npm run check )
    _say "building the static web tier…"
    ( cd "$fe" && export VITE_CATALOG_URL="${OBC_CATALOG_URL:-}" && _run npm run build:web )
    cd "$OBC_ROOT"
    _say "serving http://localhost:$port  (Ctrl-C to stop)"
    # `--directory` rather than `cd` + a relative path: the relative form resolved against the
    # *serving* directory and vanished the moment we left the repo root.
    _run python3 -m http.server "$port" --directory "$fe/dist/web"

