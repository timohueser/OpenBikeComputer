# Run explicitly selected CI gates locally. Each gate names the CI jobs it reproduces;
# `full` runs every gate in the job table and then names the required suites the run does
# NOT reproduce. Examples:
#   obc check fmt         obc check test         obc check board docs
#   obc check full        # cross-cutting changes only
# The routes live in docs/testing.md.
# Run selected CI gates locally. Args: GATE... | full
[group('build')]
check *args:
    #!/usr/bin/env bash
    set -uo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    gates=($(python3 "$OBC_TOOLS/test_plan.py" gates --list)) || exit 1
    sel=("$@")
    (( ${#sel[@]} )) || {
      _err "select one or more gates (${gates[*]:-})"
      _hint "use package-scoped checks during development; use 'obc check full' only for cross-cutting changes"
      exit 2
    }
    full=0
    if [[ "${sel[0]}" == full ]]; then
      (( ${#sel[@]} == 1 )) || { _err "'full' cannot be combined with individual gates"; exit 2; }
      full=1
      sel=("${gates[@]}")
    fi
    # A gate the job table does not know fails here, before any work.
    python3 "$OBC_TOOLS/test_plan.py" gates "${sel[@]}" || exit 1
    want() { local x; for x in "${sel[@]}"; do [[ "$x" == "$1" ]] && return 0; done; return 1; }
    FAILED=(); PASSED=(); SKIPPED=()
    step() { local label="$1"; shift; printf '\n'; _say "▶ $label"
             if _run "$@"; then PASSED+=("$label"); else _err "$label FAILED"; FAILED+=("$label"); fi; }
    cd "$OBC_ROOT"
    if want fmt; then
      step "fmt (workspace)"   cargo fmt --all --check
      step "fmt (board crate)" cargo fmt --check --manifest-path firmware/obc-fw-nrf54l/Cargo.toml
      step "fmt (bootloader)"  cargo fmt --check --manifest-path firmware/obc-boot/Cargo.toml
      step "fmt (desktop app)" cargo fmt --check --manifest-path apps/obc-desktop/Cargo.toml
    fi
    want clippy && step "clippy (workspace, all-targets/features)" \
      cargo clippy --workspace --all-targets --all-features --locked -- -D warnings
    if want test; then
      rm -rf .artifacts/python/repository-tools
      step "firmware production dependency direction" python3 "$OBC_ROOT/firmware/tools/check_dependencies.py"
      step "fixture registry unit tests" python3 -m xmlrunner discover -s tools/tests -v -o .artifacts/python/repository-tools
      step "test (fast hermetic binaries)" bash tools/ci/test.sh nextest-fast
      step "doctests (selected packages)" bash tools/ci/test.sh doctests
      step "obc-formats (default features = the device's shape)" bash tools/ci/test.sh formats-default
      step "bench golden gate (pixels + read counters)" bash tools/ci/test.sh bench-golden
    fi
    want device && step "device build (obc-app @ thumbv8m)" \
      cargo build -p obc-app --target thumbv8m.main-none-eabihf --locked
    if want board; then
      if ensure_riscv 2>/dev/null; then
        pushd "$OBC_ROOT/firmware/obc-fw-nrf54l" >/dev/null
        step "board clippy (default)"        cargo clippy --locked -- -D warnings
        step "board clippy (debug-uart)"     cargo clippy --locked --features debug-uart -- -D warnings
        step "board build (default, release)" cargo build --release --locked
        popd >/dev/null
      else _warn "skip the nRF54L gates — no RISC-V gcc (obc doctor --install)"; SKIPPED+=("embedded"); fi
      # The `board` gate is the `embedded` AND `boot` jobs. The bootloader keeps the COM wave in
      # software, so it has no FLPR blob and runs whether or not a RISC-V gcc is installed.
      pushd "$OBC_ROOT/firmware/obc-boot" >/dev/null
      step "bootloader clippy (default)"   cargo clippy --locked -- -D warnings
      step "bootloader clippy (rtt)"       cargo clippy --locked --features rtt -- -D warnings
      step "bootloader build (release)"    cargo build --release --locked
      popd >/dev/null
    fi
    if want frontend; then
      if command -v npm >/dev/null 2>&1; then
        fe="$OBC_ROOT/builder/app"
        pushd "$fe" >/dev/null
        [[ -d node_modules ]] || step "frontend deps (npm ci)" npm ci
        # Not optional: the TS wrapper imports the generated bindings, so svelte-check
        # and the byte-identity drift guard both fail without the module present. CI
        # gets all three packages from the `wasm-bridges` job; locally we build them.
        step "wasm bridges"          npm run build:wasm
        step "frontend svelte-check" npm run check
        step "frontend vitest"       npm test
        step "frontend builds (dev + web + desktop)" npm run build:all
        popd >/dev/null
      else _warn "skip frontend — npm not installed"; SKIPPED+=("frontend"); fi
    fi
    if want deny; then
      if command -v cargo-deny >/dev/null 2>&1; then
        step "deny (workspace)"    cargo deny --manifest-path "$OBC_ROOT/Cargo.toml" --all-features check --config "$OBC_ROOT/deny.toml"
        step "deny (board crate)"  cargo deny --manifest-path "$OBC_ROOT/firmware/obc-fw-nrf54l/Cargo.toml" --all-features check --config "$OBC_ROOT/deny.toml"
        step "deny (bootloader)"   cargo deny --manifest-path "$OBC_ROOT/firmware/obc-boot/Cargo.toml" --all-features check --config "$OBC_ROOT/deny.toml"
        step "deny (desktop app)"  cargo deny --manifest-path "$OBC_ROOT/apps/obc-desktop/Cargo.toml" --all-features check --config "$OBC_ROOT/deny.toml"
      else _warn "skip deny — cargo-deny not installed (cargo install cargo-deny)"; SKIPPED+=("deny"); fi
    fi
    if want wasm; then
      if command -v trunk >/dev/null 2>&1; then step "wasm (obc-web-demo → wasm)" trunk build --config "$OBC_ROOT/docs/Trunk.toml"
      else _warn "skip wasm — trunk not installed (cargo install trunk)"; SKIPPED+=("wasm"); fi
      # The assembly engine has to stay browser-shippable: the `cli` feature owns every
      # std::fs call, so building the library without it catches a stray one here.
      if rustup target list --installed | grep -q wasm32-unknown-unknown; then
        step "wasm (obcm-assemble engine)" \
          cargo build -p obcm-assemble --lib --no-default-features --locked --target wasm32-unknown-unknown
      else _warn "skip wasm engine — no wasm32 target (obc doctor --install)"; SKIPPED+=("wasm-engine"); fi
    fi
    want docs && step "docs copy and link check" python3 "$OBC_ROOT/docs/build_docs.py" --check-links
    printf '\n'; _say "check summary"
    (( ${#PASSED[@]} ))  && _ok   "passed:  ${PASSED[*]}"
    (( ${#SKIPPED[@]} )) && _warn "skipped: ${SKIPPED[*]}"
    # No unqualified CI-parity claim: the plan names what this run leaves to CI.
    (( full )) && python3 "$OBC_TOOLS/test_plan.py" gates --unreproduced "${sel[@]}"
    if (( ${#FAILED[@]} )); then _err "failed:  ${FAILED[*]}"; exit 1; fi
    _ok "all run gates passed"

