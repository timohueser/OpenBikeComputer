    source "{{lib}}"; obc_init; ensure_geos
    cd "$OBC_ROOT"; _run cargo build --release

# A scope is required: `obc test -p obc-pack` runs nextest and then the same scope's doctests;
# `--lib` runs the library target alone and no doctests.
# The plan selector runs the affected packages and suites and prints why:
#
#   obc test affected --base origin/develop [--head REF] [--dry-run]
#
# `obc test fixtures -p <crate>` keeps its scoped meaning (sync + external-fixtures) and
# needs neither the plan nor Git. `full` stays the exceptional cross-cutting gate.
# See docs/testing.md for the routes.
# Run focused host tests. Args: -p CRATE [--lib] | fixtures -p CRATE | affected --base REF | full
[group('test')]
test *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init; ensure_geos
    cd "$OBC_ROOT"
    mode="${1:-}"
    [[ -n "$mode" ]] || {
      _err "a test scope is required"
      _hint "focused: obc test -p <crate> [test-filter]"
      _hint "captured fixtures: obc test fixtures -p <crate>"
      _hint "by change: obc test affected --base origin/develop [--dry-run]"
      _hint "cross-cutting only: obc test full"
      exit 2
    }
    require_scope() {
      local arg
      for arg in "$@"; do
        case "$arg" in
          -p|--package|--package=*|--manifest-path|--manifest-path=*) return 0 ;;
        esac
      done
      return 1
    }
    library_only() {
      local arg
      for arg in "$@"; do
        case "$arg" in --lib) return 0 ;; esac
      done
      return 1
    }
    fixture_env() {
      _run python3 "$OBC_TOOLS/fixtures.py" sync test
      export OBC_FIXTURE_ROOT
      OBC_FIXTURE_ROOT="$(python3 "$OBC_TOOLS/fixtures.py" root)"
    }
    case "$mode" in
      full)
        shift
        _run cargo nextest run --workspace --all-features --locked --no-tests fail --filter-expr "$(python3 tools/test_plan.py cargo-filter --tier fast)" "$@"
        fixture_env
        _run cargo nextest run --workspace --all-features --locked --no-tests fail --filter-expr "$(python3 tools/test_plan.py cargo-filter --tier fixtures)" "$@"
        _run cargo test --workspace --all-features --locked --doc
        ;;
      affected)
        shift
        _run python3 "$OBC_TOOLS/test_plan.py" run "$@"
        ;;
      fixtures)
        shift
        require_scope "$@" || {
          _err "a Cargo package scope is required (-p/--package or --manifest-path)"
          _hint "example: obc test fixtures -p obc-route"
          exit 2
        }
        fixture_env
        _run cargo test --locked --features external-fixtures "$@"
        ;;
      *)
        require_scope "$@" || {
          _err "a Cargo package scope is required (-p/--package or --manifest-path)"
          _hint "example: obc test -p obc-app"
          exit 2
        }
        # `--no-tests warn`: a package with no test yet is not a failed run. The workspace
        # runs in `obc test full` and CI keep the default `fail`.
        _run cargo nextest run --locked --no-tests warn "$@"
        # `--lib` is the library-only loop: nextest builds one target and doctests, which are a
        # separate Cargo run over the whole package, stay out of it. Cargo rejects `--lib` on a
        # package with no library, so an unbuildable scope fails before anything runs.
        if ! library_only "$@"; then
          # A scope with no library is a hard error for `--doc`, not an empty run, so a
          # binary-only package would fail the task after every one of its tests passed.
          if python3 "$OBC_TOOLS/cargo_scope.py" has-library "$@"; then
            _run cargo test --locked --doc "$@"
          else
            _hint "no library in this scope: no doctests to run"
          fi
        fi
        ;;
    esac

# The workspace excludes three crates, and rustfmt walks up from each file to find its
# own manifest — so this is a FOUR-step and the fmt CI guard fails if a leg is skipped.
# Format everything: the workspace + board crate + bootloader + desktop app (four-step).
[group('build')]
fmt:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    cd "$OBC_ROOT"
    _run cargo fmt --all
    _run cargo fmt --manifest-path firmware/obc-fw-nrf54l/Cargo.toml
    _run cargo fmt --manifest-path firmware/obc-boot/Cargo.toml
    _run cargo fmt --manifest-path apps/obc-desktop/Cargo.toml

