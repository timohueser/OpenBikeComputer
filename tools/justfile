# DEVICE is a `devicectl` name or identifier; it defaults to the only paired phone.
# Build the OBCDevice app (the firmware on a phone) and install and launch it on a paired iPhone. Args: [DEVICE]
[group('ios')]
ios-device *args:
    #!/usr/bin/env bash
    set -euo pipefail
    source "{{lib}}"; obc_init
    cd "$OBC_ROOT"
    (( $# <= 1 )) || { _err "usage: obc ios-device [DEVICE]"; exit 1; }
    device="$(ios_phone "${1:-}")"
