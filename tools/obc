#!/usr/bin/env bash
# obc — thin wrapper around `just` for OpenBikeComputer dev tasks.
# Uses the current OBC checkout, or the installed checkout outside OBC.
# Relative MAP/GPX paths resolve against your current directory.
# Test levels, suite cadence, and proportional verification are defined in docs/testing.md.
set -euo pipefail

# Resolve this script's real directory, following symlinks (e.g. ~/.local/bin/obc).
src="${BASH_SOURCE[0]}"
while [ -h "$src" ]; do
  dir="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"
  src="$(readlink "$src")"; [[ "$src" != /* ]] && src="$dir/$src"
done
root="$(cd -P "$(dirname "$src")" >/dev/null 2>&1 && pwd)"

# Keep the global human entry point; select local tools inside an OBC worktree.
checkout="$(git rev-parse --show-toplevel 2>/dev/null || true)"
if [[ -n "$checkout" && -f "$checkout/tools/obc" && -f "$checkout/tools/justfile" && -d "$checkout/firmware/obc-app" ]]; then
  root="$checkout/tools"
fi
printf 'obc: checkout %s\n' "$(dirname "$root")" >&2

if ! command -v just >/dev/null 2>&1; then
  echo "obc: 'just' is not installed — install it with:  cargo install just" >&2
  exit 127
fi

# `obc` lists every group but `agent`; `--agent` and `--all` reach the rest, and `obc help TASK`
# or `obc TASK --help` describes one task. These are wrapper flags, not just flags, so they go
# straight to the listing script.
case "${1:-}" in
  --agent|--all) exec python3 "$root/tasks.py" --justfile "$root/justfile" "$1" ;;
  help|-h|--help) exec python3 "$root/tasks.py" --justfile "$root/justfile" ${2:+--task "$2"} ;;
esac
case "${2:-}" in
  -h|--help) exec python3 "$root/tasks.py" --justfile "$root/justfile" --task "$1" ;;
esac

exec just --justfile "$root/justfile" --working-directory "$PWD" "$@"
