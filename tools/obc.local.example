# Personal defaults for the `obc` dev tasks. Copy to `tools/obc.local` (gitignored) and edit.
# This file is sourced as bash, so it's plain KEY=value (no `export` needed).
# Paths are relative to the repo root (the parent of this tools/ dir).
# Linked worktrees fall back to this file in the main checkout, so credentials
# and personal defaults only need to be configured once.

# Default map for an explicit local-file `obc sim` invocation. Bare `obc sim`
# runs the registry's `grimsel` scenario; named scenarios ignore this setting.
#OBC_MAP="freiburg.obcm"

# Default GPX track for explicit local maps and `obc uart`. Registry scenarios
# supply their own coherent track.
#OBC_GPX="tracks/my-favourite-loop.gpx"

# Default packer config for `obc pack`. If unset, builder/presets/schema.json —
# the one shipped schema. Point this at your own config to pack with that instead.
#OBC_PRESET="my-style.json"

# Extra directories to scan for maps (colon-separated) — overrides the default
# root : maps/ : ~/.cache/obcm/builds search.
#OBC_MAPS_DIRS="$HOME/maps:$HOME/Downloads"

# Cell-catalog operator settings. `obc bake`, `obc bake verify`, and
# `obc bake publish` all use this tree. Keep R2 credentials only in this gitignored
# local file (or in your shell environment), never in the tracked justfile.
OBC_BAKE_TREE="$HOME/obc-bake"
OBC_MAPS_BASE_URL="https://maps.openbikecomputer.com/cell-catalog"
OBC_CATALOG_URL="$OBC_MAPS_BASE_URL/catalog.json"
OBC_R2_PREFIX="cell-catalog"
# Local maintainer schema-lab source. Leave unset: `obc web preview-source`
# downloads/reuses Freiburg-regbez and prepares a small, reference-complete
# Teningen PBF under ~/.cache/obcm/schema-preview. An override means an
# already-prepared absolute .osm.pbf and is never downloaded to or overwritten;
# the browser can never supply a source path.
#OBC_SCHEMA_PREVIEW_PBF="$HOME/maps/teningen-reference-complete.osm.pbf"
#OBC_R2_ACCOUNT_ID="..."
#OBC_R2_BUCKET="..."
#OBC_R2_ACCESS_KEY_ID="..."
#OBC_R2_SECRET_ACCESS_KEY="..."

# Weather VPS operator target for `obc weather status|start|stop`. The command
# deliberately requires a root SSH login because it controls systemd units. This
# is not the public R2 hostname; use the VPS hostname/IP or a configured SSH alias.
#OBC_WX_SSH_TARGET="root@wx-server.example.com"

# RISC-V gcc for the board's FLPR blob, if it isn't on your PATH.
#RISCV_GCC="$HOME/.local/xPacks/riscv-none-elf-gcc/14.2.0-3/bin/riscv-none-elf-gcc"
