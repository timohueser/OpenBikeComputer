{
  "name": "obc-verification",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --host 127.0.0.1",
    "demo:coverage": "node --experimental-strip-types ops/coverage-demo.ts",
    "build": "vite build",
    "start": "node build",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "verify": "npm run check && npm test && npm run build",
    "test:ci": "node --experimental-strip-types --test --test-reporter=junit --test-reporter-destination=verification-junit.xml tests/*.test.ts"
  },
  "dependencies": {
    "@sveltejs/adapter-node": "5.5.7",
    "@sveltejs/kit": "2.70.3",
    "dompurify": "^3.4.15",
    "harper.js": "^2.10.0",
    "marked": "18.0.13",
    "sanitize-html": "2.17.7",
    "svelte": "5.57.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.0",
    "@types/node": "^24.0.0",
    "@types/sanitize-html": "^2.16.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "8.3.0"
  }
}
