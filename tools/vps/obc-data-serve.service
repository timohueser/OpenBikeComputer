# The follower: `obc data serve prod` and the services of the planner releases that prod names.
# tools/vps/README.md installs it; tools/vps/deploy-services.sh puts the code in /opt/obc-data.
[Unit]
Description=OpenBikeComputer data follower
After=network-online.target
Wants=network-online.target

[Service]
User=obc-data
WorkingDirectory=/opt/obc-data/current
Environment=OBC_DATA_STORE=/var/lib/obc-data/store
# `python3` is the Python that uv installs for obc-data; the Debian Python is older than the pin.
Environment=PATH=/var/lib/obc-data/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/obc-data/current/target/release/obc-data-plumbing serve prod
Restart=on-failure
RestartSec=10
# The page cache of the services counts for the unit, so the unit may use the RAM of the machine
# less a tenth for the system (sshd, Caddy, journald). When the kernel kills one process, only that
# service stops, and the follower starts it again. The routing workers follow the CPUs of the
# machine, and the tasks follow the systemd default.
MemoryMax=90%
OOMPolicy=continue
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/obc-data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
