# The follower: `obc data serve prod` and the services of the planner releases that prod names.
# tools/vps/README.md installs it; tools/vps/deploy-services.sh puts the code in /opt/obc-data.
[Unit]
Description=OpenBikeComputer data follower
After=network-online.target
Wants=network-online.target

[Service]
User=obc-data
WorkingDirectory=/opt/obc-data/current
Environment=OBC_DATA_STORE=/var/lib/obc-data/store
ExecStart=/opt/obc-data/current/target/release/obc-data-plumbing serve prod
Restart=on-failure
RestartSec=10
# Three times the sum of the limits of the legacy planner units for routing (2048M), search (768M)
# and downloads (256M), each with CPUQuota=200% and TasksMax=64: serve runs these three services for
# the release of planner/next.json, the serving release and the rollback.
MemoryMax=9216M
CPUQuota=1800%
TasksMax=576
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/obc-data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
