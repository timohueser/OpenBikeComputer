# The follower: `obc data serve prod` and the services of the planner releases that prod names.
# tools/vps/README.md installs it; tools/vps/deploy-services.sh puts the code in /opt/obc-data.
[Unit]
Description=OpenBikeComputer data follower
After=network-online.target
Wants=network-online.target

[Service]
User=obc-data
WorkingDirectory=/opt/obc-data/current
# At start, serve builds planner-service with cargo; the deploy already built it.
Environment=PATH=/var/lib/obc-data/.cargo/bin:/usr/local/bin:/usr/bin:/bin
Environment=OBC_DATA_STORE=/var/lib/obc-data/store
ExecStart=/opt/obc-data/current/target/release/obc-data-plumbing serve prod
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/obc-data /opt/obc-data

[Install]
WantedBy=multi-user.target
