# Trunk wasm build output (the live device demo). Built from source by CI for the site.
dist/

# Generated documentation HTML. Source is content/*.md; build_docs.py renders into
# docs/ (this nested dir is what Trunk copy-dirs into dist/docs/). Regenerated by the
# Trunk pre_build hook on every build/serve, so it never needs to be committed —
# except .gitkeep: trunk canonicalizes the [watch] ignore path at startup, before
# the pre_build hook runs, so the dir must already exist on a fresh checkout (#625).
# `docs/*` rather than `docs/` because git cannot re-include a file whose parent
# directory is excluded.
docs/*
!docs/.gitkeep

# Same deal for the rendered blog (source is content/blog/**; Trunk copy-dirs blog/
# into dist/blog/).
blog/*
!blog/.gitkeep
