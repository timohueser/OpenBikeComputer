[Unit]
Description=OpenBikeComputer verification and releases
After=network-online.target
Wants=network-online.target

[Service]
User=obc-verification
Group=obc-verification
WorkingDirectory=/opt/obc-verification/current
EnvironmentFile=/etc/obc-verification/service.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3100
Environment=VERIFICATION_DATA_DIR=/var/lib/obc-verification
Environment=BODY_SIZE_LIMIT=70M
ExecStart=/usr/local/bin/node /opt/obc-verification/current/build/index.js
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/obc-verification
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
