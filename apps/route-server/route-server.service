[Unit]
Description=OpenBikeComputer regional routing
After=network.target

[Service]
Type=simple
DynamicUser=yes
ExecStart=/opt/obc-routing/bin/route-server /opt/obc-routing/region
Environment=ROUTE_LISTEN=127.0.0.1:8788
Environment=ROUTE_WORKERS=2
Restart=on-failure
RestartSec=3
MemoryMax=1536M
CPUQuota=200%
TasksMax=64
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
