+/// Spill the actual final placement as a dense-ID-indexed direct-reference table.
+/// Serialization resolves references into a checksum while preserving v16 output.
+fn probe_direct_refs(
+    scratch: &dyn ScratchStore,
+    budget: usize,
+    share: usize,
+    flat: &qtree::Flattened,
+    node_count: u32,
+) -> Result<ScratchId> {
+    let by_id = |a: &[u8; 8], b: &[u8; 8]| a[..4].cmp(&b[..4]);
+    // Big-endian keys give numeric order to the external sort's byte comparison.
+    let mut mapping = ExternalSort::<8>::new(scratch, budget, by_id);
+    let mut current = u32::MAX;
+    let mut ordinal = 0u32;
+    let mut used = 0usize;
+    for p in SpillReader::<{ qtree::PLACE_REC }>::open(scratch, flat.places, share)? {
+        let p = p?;
+        let chunk = qtree::place_chunk(&p);
+        if chunk != current {
+            current = chunk;
+            ordinal = 0;
+            used = 0;
+        }
+        for r in qtree::read_run(scratch, flat.points, qtree::place_first(&p), qtree::place_count(&p))? {
+            let len = qtree::rec_len(&r) as usize;
+            if used + len > NAV_CHUNK_SIZE {
+                continue;
+            }
+            if chunk >= (1 << 26) || ordinal >= 39 {
+                return Err(Error::Capacity("direct-reference probe exceeds 26/6-bit allocation".into()));
+            }
+            let mut entry = [0u8; 8];
+            entry[..4].copy_from_slice(&qtree::rec_ord(&r).to_be_bytes());
+            entry[4..].copy_from_slice(&((chunk << 6) | ordinal).to_le_bytes());
+            mapping.push(entry)?;
+            ordinal += 1;
+            used += len;
+        }
+    }
+    let mut table = SpillWriter::<4>::create(scratch, share)?;
+    let mut count = 0u32;
+    for entry in mapping.finish()? {
+        let entry = entry?;
+        if u32::from_be_bytes(entry[..4].try_into().unwrap()) != count {
+            return Err(Error::Format("direct-reference probe requires every dense node placement".into()));
+        }
+        table.push(entry[4..].try_into().unwrap())?;
+        count += 1;
+    }
+    if count != node_count {
+        return Err(Error::Format("direct-reference probe lost a node placement".into()));
+    }
+    let (table, _) = table.seal()?;
+    Ok(table)
+}
