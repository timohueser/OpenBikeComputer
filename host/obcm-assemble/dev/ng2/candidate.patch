+#[test]
+fn direct_reference_with_wrong_neighbor_coordinates_cannot_expand() {
+    let mut bytes = map_with(&line_graph(6, SP, EDGE_COST));
+    let src = SliceSource(&bytes);
+    let tables = MapTables::parse(&src).unwrap();
+    let cache = MapCache::new();
+    let reader = Reader::new(&src, &tables, &cache);
+    let dir = *reader.nav_directory();
+    let start = dir.data_start().unwrap() as usize;
+    for chunk in bytes[start..start + dir.chunk_count * 512].chunks_exact_mut(512) {
+        let mut at = 0;
+        while at + 13 <= chunk.len() && chunk[at + 12] != 255 {
+            for n in 0..chunk[at + 12] as usize {
+                let delta = at + 13 + n * 17 + 4;
+                chunk[delta..delta + 2].copy_from_slice(&1i16.to_le_bytes());
+            }
+            at += 13 + chunk[at + 12] as usize * 17;
+        }
+    }
+    let (result, _, _) = plan(&bytes, BASE, (BASE.0 + 5 * SP, BASE.1), "Wrong coordinates");
+    assert_eq!(result, Err(NavError::NoPath));
+}
