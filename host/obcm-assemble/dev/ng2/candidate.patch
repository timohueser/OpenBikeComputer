+        if rd_u32(chunk, off + 8) != id {
+            return Ok(false);
+        }
+        let end = off + NAV_NODE_FIXED_LEN + chunk[off + 12] as usize * NAV_NEIGHBOR_LEN;
+        visit(NavNodeRef {
+            lat: rd_i32(chunk, off),
+            lon: rd_i32(chunk, off + 4),
+            id,
+            neighbors: &chunk[off + NAV_NODE_FIXED_LEN..end],
+        });
+        #[cfg(feature = "nav-metrics")]
+        {
+            tiles.decoded_junctions += 1;
+        }
+        Ok(true)
+    }
