+fn direct_node_offset(chunk: &[u8], ordinal: usize) -> Option<usize> {
+    if ordinal >= 30 {
+        return None;
+    }
+    let mut off = 0usize;
+    for record in 0..=ordinal {
+        let degree = *chunk.get(off.checked_add(12)?)? as usize;
+        if degree > 24 {
+            return None;
+        }
+        let end = off.checked_add(NAV_NODE_FIXED_LEN + degree * NAV_NEIGHBOR_LEN)?;
+        if end > chunk.len() {
+            return None;
+        }
+        if record == ordinal {
+            return Some(off);
+        }
+        off = end;
+    }
+    None
+}
