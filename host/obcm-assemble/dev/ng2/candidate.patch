+#[test]
+fn direct_node_reference_checks_boundaries_and_failed_fills() {
+    use core::cell::Cell;
+    use obc_formats::io::{ByteSource, Error as IoError};
+    use obc_reader::NavTileCache;
+    struct Fault<'a> {
+        bytes: &'a [u8],
+        fail: Cell<bool>,
+        graph: u64,
+    }
+    impl ByteSource for Fault<'_> {
+        fn read_at(&self, at: u64, out: &mut [u8]) -> Result<(), IoError> {
+            if self.fail.get() && at >= self.graph {
+                return Err(IoError::Io);
+            }
+            SliceSource(self.bytes).read_at(at, out)
+        }
+        fn len(&self) -> u64 {
+            self.bytes.len() as u64
+        }
+    }
+    let mut bytes = single_leaf(GLOBAL, pack_line(1, 10, 20, &[(1, 1)]), 512);
+    let nav = resolve_offset(&bytes, 36);
+    let index = (bytes.len() + 15) & !15;
+    let data = index + 16;
+    bytes.resize(data + 512, 255);
+    bytes[index..index + 4].copy_from_slice(&0u32.to_le_bytes());
+    bytes[nav..nav + 4].copy_from_slice(&scaled(index).to_le_bytes());
+    bytes[nav + 4..nav + 8].copy_from_slice(&1u32.to_le_bytes());
+    bytes[nav + 8..nav + 12].copy_from_slice(&1u32.to_le_bytes());
+    for id in 0..30u32 {
+        let at = data + id as usize * 13;
+        bytes[at..at + 13].copy_from_slice(&obcm_testkit::pack_nav_record(20, 10, id, &[]));
+    }
+    let cache = MapCache::new();
+    let mut tiles = NavTileCache::new();
+    let source = Fault { bytes: &bytes, fail: Cell::new(false), graph: data as u64 };
+    let tables = MapTables::parse(&source).unwrap();
+    let reader = Reader::new(&source, &tables, &cache);
+    source.fail.set(true);
+    assert!(reader.nav_node_direct_cached(29, &mut tiles, |_| {}).is_err());
+    source.fail.set(false);
+    let mut found = false;
+    assert!(reader
+        .nav_node_direct_cached(29, &mut tiles, |node| {
+            assert_eq!((node.id, node.lon, node.lat), (29, 10, 20));
+            found = true;
+        })
+        .unwrap());
+    assert!(found);
+    for id in [30, 31, 32, u32::MAX - 1, u32::MAX] {
+        assert!(!reader.nav_node_direct_cached(id, &mut tiles, |_| panic!("invalid reference visited")).unwrap());
+    }
+    assert_eq!(tiles.stats().index_hits + tiles.stats().index_misses, 0);
+    // A replacement map with the same offsets must not serve the preceding map's chunk.
+    bytes[data + 12] = 255;
+    let source = SliceSource(&bytes);
+    let tables = MapTables::parse(&source).unwrap();
+    let reader = Reader::new(&source, &tables, &cache);
+    tiles.reset();
+    assert!(!reader.nav_node_direct_cached(29, &mut tiles, |_| panic!("missing target")).unwrap());
+    bytes[data + 12] = 0;
+    bytes[data + 29 * 13 + 12] = 24;
+    let source = SliceSource(&bytes);
+    let tables = MapTables::parse(&source).unwrap();
+    let reader = Reader::new(&source, &tables, &cache);
+    tiles.reset();
+    assert!(!reader.nav_node_direct_cached(29, &mut tiles, |_| panic!("record crosses chunk")).unwrap());
+    bytes[data + 29 * 13 + 12] = 0;
+    bytes[data + 8..data + 12].copy_from_slice(&42u32.to_le_bytes());
+    let source = SliceSource(&bytes);
+    let tables = MapTables::parse(&source).unwrap();
+    let reader = Reader::new(&source, &tables, &cache);
+    tiles.reset();
+    assert!(!reader.nav_node_direct_cached(0, &mut tiles, |_| panic!("wrong identity")).unwrap());
+    // Corrupt prefix lengths cannot reinterpret payload bytes as the requested record.
+    bytes[data + 12] = 25;
+    let source = SliceSource(&bytes);
+    let tables = MapTables::parse(&source).unwrap();
+    let reader = Reader::new(&source, &tables, &cache);
+    tiles.reset();
+    assert!(!reader.nav_node_direct_cached(1, &mut tiles, |_| panic!("invalid boundary")).unwrap());
+}
