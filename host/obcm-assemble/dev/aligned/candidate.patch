+fn main() {
+    let args: Vec<_> = std::env::args_os().collect();
+    let mut bytes = std::fs::read(&args[1]).unwrap();
+    let offset = bytes.len().next_multiple_of(16);
+    let nav = obc_pack::serialize::repack_nav_candidate(&bytes, offset);
+    bytes.resize(offset, 255);
+    bytes.extend_from_slice(&nav);
+    bytes[4] = obc_formats::obcm::VERSION;
+    bytes[36..40].copy_from_slice(&((offset / 16) as u32).to_le_bytes());
+    let source = SliceSource(&bytes);
+    let tables = MapTables::parse(&source).unwrap();
+    let cache = MapCache::new();
+    let reader = Reader::new(&source, &tables, &cache);
+    let mut targets = NavTileCache::new();
+    let mut scratch = [0u8; 512];
+    let mut nodes = 0;
+    let mut arcs = 0;
+    reader
+        .for_each_nav_record(&mut scratch, |node| {
+            nodes += 1;
+            for neighbor in node.neighbors() {
+                arcs += 1;
+                assert!(reader
+                    .nav_node_direct_cached(neighbor.id, &mut targets, |target| {
+                        assert_eq!((neighbor.lat, neighbor.lon), (target.lat, target.lon));
+                    })
+                    .unwrap());
+            }
+        })
+        .unwrap();
+    std::fs::write(&args[2], &bytes).unwrap();
+    println!("{{\"nodes\":{nodes},\"arcs\":{arcs},\"nav_bytes\":{}}}", nav.len());
+}
