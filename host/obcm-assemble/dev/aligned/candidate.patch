+        node_count,
+        chunks: &chunks,
+        chunk_count,
+        pool: region(dir.edge_pool_offset, dir.edge_chunk_count * NAV_CHUNK_SIZE),
+        edge_chunk_count: dir.edge_chunk_count as u32,
+        snap_index: region(dir.snap_index_offset, dir.snap_node_count * 4),
+        snap_node_count: dir.snap_node_count as u32,
+        snap_chunks: region(dir.snap_data_start().unwrap(), dir.snap_chunk_count * NAV_CHUNK_SIZE),
