+pub fn repack_nav_candidate(bytes: &[u8], section_offset: usize) -> Vec<u8> {
+    use obc_formats::io::SliceSource;
+    use obc_reader::{MapCache, MapTables, Reader};
+    let source = SliceSource(bytes);
+    let tables = MapTables::parse(&source).unwrap();
+    let cache = MapCache::new();
+    let reader = Reader::new(&source, &tables, &cache);
+    let dir = reader.nav_directory();
+    let mut points = Vec::new();
+    let mut scratch = [0u8; NAV_CHUNK_SIZE];
+    reader
+        .for_each_nav_record(&mut scratch, |n| {
