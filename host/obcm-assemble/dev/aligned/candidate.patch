+#[test]
+fn aligned_node_references_follow_the_largest_header_scale() {
+    use obc_formats::io::{ByteSource, Error as IoError};
+    use obc_reader::NavTileCache;
+    let template = single_leaf(GLOBAL, pack_line(1, 10, 20, &[(1, 1)]), 512);
+    let mut bytes = vec![255u8; 4608];
+    bytes[..57].copy_from_slice(&template[..57]);
+    bytes[4] = obc_formats::obcm::VERSION;
+    bytes[40] = 9;
+    let put = |b: &mut [u8], at, value: u32| b[at..at + 4].copy_from_slice(&value.to_le_bytes());
+    for (field, units) in [(21, 1), (26, 2), (32, 3), (36, 4)] {
+        put(&mut bytes, field, units);
+    }
+    bytes[25] = 1;
+    bytes[512..516].fill(0); // Empty styles and the empty LOD's final offset.
+    bytes[1024..1042].fill(0);
+    put(&mut bytes, 1028, 1); // Empty LOD index.
+    bytes[1536..1545].fill(0);
+    put(&mut bytes, 1539, 1); // Empty POI hours pool.
+    bytes[2048..2088].fill(0);
+    for (field, value) in [(0, 6), (4, 1), (8, 2), (12, 9), (22, 5), (28, 9)] {
+        put(&mut bytes, 2048 + field, value);
+    }
+    bytes[2068..2070].copy_from_slice(&512u16.to_le_bytes());
+    bytes[2074] = 1;
+    bytes[2560..2616].copy_from_slice(&obcm_testkit::default_nav_profile_table());
+    put(&mut bytes, 3072, 1); // The spatial leaf names the second node chunk.
+    bytes[3584..3597].copy_from_slice(&obcm_testkit::pack_nav_record(20, 10, 0, &[]));
+    bytes[4096..4109].copy_from_slice(&obcm_testkit::pack_nav_record(40, 30, 1, &[]));
+    let source = SliceSource(&bytes);
+    let tables = MapTables::parse(&source).unwrap();
+    let cache = MapCache::new();
+    let reader = Reader::new(&source, &tables, &cache);
+    let mut targets = NavTileCache::new();
+    assert_eq!(reader.nav_directory().node_alignment, 512);
+    assert!(reader
+        .nav_node_direct_cached(1, &mut targets, |node| {
+            assert_eq!((node.id, node.dense_id, node.lon, node.lat), (1, 1, 30, 40));
+        })
+        .unwrap());
+    for id in [2, u32::MAX - 1, u32::MAX] {
+        assert!(!reader.nav_node_direct_cached(id, &mut targets, |_| panic!("invalid reference")).unwrap());
+    }
+    // The reference-range guard must reject a run that includes reserved units,
+    // even when a source claims enough bytes for the entire run.
+    struct Large<'a>(&'a [u8]);
+    impl ByteSource for Large<'_> {
+        fn read_at(&self, at: u64, out: &mut [u8]) -> Result<(), IoError> {
+            SliceSource(self.0).read_at(at, out)
+        }
+        fn len(&self) -> u64 {
+            u64::MAX
+        }
+    }
+    put(&mut bytes, 2056, u32::MAX);
+    assert!(matches!(MapTables::parse(&Large(&bytes)), Err(Error::BadOffset)));
+}
