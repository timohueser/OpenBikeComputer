+                lat: n.lat,
+                lon: n.lon,
+                id: n.dense_id,
+                neighbors: n
+                    .neighbors()
+                    .map(|n| WireNeighbor {
+                        id: n.id,
+                        lat: n.lat,
+                        lon: n.lon,
+                        edge_id: n.edge_id,
+                        cost_m: n.cost_m,
+                        way_kind: n.way_kind,
+                        ascent_m: n.ascent_m,
+                    })
+                    .collect(),
+            });
+        })
+        .unwrap();
+    points.sort_by_key(|point| point.id);
+    let b = tables.bbox;
+    let root = build_nav_tree(
+        points,
+        (b.min_lon as i64, b.min_lat as i64, b.max_lon as i64, b.max_lat as i64),
+        NAV_CHUNK_SIZE,
+    );
