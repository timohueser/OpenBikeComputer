index 00000000..f67f3d70
--- /dev/null
+++ b/host/obcm-assemble/src/nav/cell_order.rs
@@ -0,0 +1,161 @@
+//! NG3 experiment: retain cell node order and resolve endpoints one cell at a time.
+use super::*;
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn renumber(
+    scratch: &dyn ScratchStore,
+    share: usize,
+    node_file: ScratchId,
+    node_comp: ScratchId,
+    keep: &[bool],
+    deltas: &[(u32, u64)],
+    cell_base: &[u32],
+    seam_id: &[u32],
+    cells: &[&Cell<'_>],
+) -> Result<(ScratchId, u32, ScratchId)> {
+    let mut counts = vec![0u32; cells.len()];
+    let mut seams = Vec::new();
+    let mut labels = SpillReader::<4>::open(scratch, node_comp, share)?;
+    let mut cell = 0;
+    for (id, rec) in SpillReader::<NODE_REC>::open(scratch, node_file, share)?.enumerate() {
+        let rec = rec?;
+        while id as u32 >= cell_base[cell + 1] { cell += 1; }
+        let label = labels.next().ok_or_else(|| Error::Scratch("missing node label".into()))??;
+        if !keep[u32::from_le_bytes(label) as usize] { continue; }
+        if seam_id.binary_search(&(id as u32)).is_ok() {
+            seams.push((id as u32, rec));
+        } else {
+            counts[cell] += 1;
+        }
+    }
+    let mut order: Vec<_> = (0..cells.len()).collect();
+    order.sort_by_key(|&cell| cells[cell].id);
+    let mut next = vec![0u32; cells.len()];
+    let mut total = 0u32;
+    for &cell in &order {
+        next[cell] = total;
+        total = total.checked_add(counts[cell]).ok_or_else(|| Error::Capacity("node identity overflow".into()))?;
+    }
+    seams.sort_by_key(|(_, rec)| (i32::from_le_bytes(rec[..4].try_into().unwrap()), i32::from_le_bytes(rec[4..8].try_into().unwrap())));
+    let mut seam_dense = HashMap::new();
+    for &(id, _) in &seams {
+        seam_dense.insert(id, total);
+        total = total.checked_add(1).ok_or_else(|| Error::Capacity("node identity overflow".into()))?;
+    }
+    let mut labels = SpillReader::<4>::open(scratch, node_comp, share)?;
+    let mut mapping = SpillWriter::<JOIN_REC>::create(scratch, share)?;
+    let mut delta = 0usize;
+    cell = 0;
+    for (id, rec) in SpillReader::<NODE_REC>::open(scratch, node_file, share)?.enumerate() {
+        let rec = rec?;
+        while id as u32 >= cell_base[cell + 1] { cell += 1; }
+        let label = labels.next().ok_or_else(|| Error::Scratch("missing node label".into()))??;
+        let dense = if !keep[u32::from_le_bytes(label) as usize] {
+            u32::MAX
+        } else if let Some(&dense) = seam_dense.get(&(id as u32)) {
+            dense
+        } else {
+            let dense = next[cell];
+            next[cell] += 1;
+            dense
+        };
+        let mut entry = [0; JOIN_REC];
+        entry[..4].copy_from_slice(&(id as u32).to_le_bytes());
+        entry[4..8].copy_from_slice(&dense.to_le_bytes());
+        entry[8..16].copy_from_slice(&rec[..8]);
+        let mut digest = u64::from_le_bytes(rec[8..16].try_into().expect("digest"));
+        while delta < deltas.len() && deltas[delta].0 == id as u32 {
+            digest = digest.wrapping_add(deltas[delta].1);
+            delta += 1;
+        }
+        entry[16..24].copy_from_slice(&digest.to_le_bytes());
+        mapping.push(entry)?;
+    }
+    scratch.remove(node_file)?;
+    scratch.remove(node_comp)?;
+    let mapping = mapping.seal()?.0;
+    let mut nodes = SpillWriter::<DENSE_NODE>::create(scratch, share)?;
+    let mut local = Vec::new();
+    for &cell in &order {
+        local.resize((cell_base[cell + 1] - cell_base[cell]) as usize * JOIN_REC, 0);
+        scratch.read_at(mapping, u64::from(cell_base[cell]) * JOIN_REC as u64, &mut local)?;
+        for entry in local.as_chunks::<JOIN_REC>().0 {
+            let id = u32::from_le_bytes(entry[..4].try_into().unwrap());
+            let dense = u32::from_le_bytes(entry[4..8].try_into().unwrap());
+            if dense != u32::MAX && !seam_dense.contains_key(&id) {
+                nodes.push(entry[8..16].try_into().unwrap())?;
+            }
+        }
+    }
+    for (_, rec) in seams { nodes.push(rec[..8].try_into().unwrap())?; }
+    Ok((nodes.seal()?.0, total, mapping))
+}
+
+#[allow(clippy::too_many_arguments)]
+pub(super) fn join<'s>(
+    scratch: &'s dyn ScratchStore,
+    budget: usize,
+    share: usize,
+    edge_file: ScratchId,
+    pruned: &prune::Pruned,
+    dead: &[u32],
+    mapping: ScratchId,
+    cell_base: &[u32],
+    seam_id: &[u32],
+    stats: &mut NavStats,
+) -> Result<ExternalSort<'s, DENSE_REC>> {
+    let mut seams = HashMap::new();
+    for &id in seam_id {
+        let mut record = [0; JOIN_REC];
+        scratch.read_at(mapping, u64::from(id) * JOIN_REC as u64, &mut record)?;
+        seams.insert(id, record);
+    }
+    let mut out = ExternalSort::new(scratch, budget / 2, by_emission);
+    let mut labels = SpillReader::<4>::open(scratch, pruned.edge_comp, share)?;
+    let mut next_dead = 0usize;
+    let mut cell = usize::MAX;
+    let mut local = Vec::<u8>::new();
+    for (index, rec) in SpillReader::<EDGE_REC>::open(scratch, edge_file, share)?.enumerate() {
+        let rec = rec?;
+        if next_dead < dead.len() && dead[next_dead] as usize == index {
+            next_dead += 1;
+            continue;
+        }
+        let label = labels.next().ok_or_else(|| Error::Scratch("missing edge label".into()))??;
+        if !pruned.keep[u32::from_le_bytes(label) as usize] {
+            continue;
+        }
+        let next_cell = edge_cell(&rec) as usize;
+        if next_cell != cell {
+            cell = next_cell;
+            let count = cell_base[cell + 1] - cell_base[cell];
+            local.resize(count as usize * JOIN_REC, 0);
+            scratch.read_at(mapping, u64::from(cell_base[cell]) * JOIN_REC as u64, &mut local)?;
+        }
+        let mut wide = [0; DENSE_REC];
+        for (id, at) in [(edge_a(&rec), A_AT), (edge_b(&rec), B_AT)] {
+            let entry = if id >= cell_base[cell] && id < cell_base[cell + 1] {
+                let offset = (id - cell_base[cell]) as usize * JOIN_REC;
+                local[offset..offset + JOIN_REC].try_into().expect("mapping record")
+            } else {
+                seams.get(&id).ok_or_else(|| Error::Format("foreign non-boundary endpoint".into()))?
+            };
+            if u32::from_le_bytes(entry[4..8].try_into().expect("identity")) == u32::MAX {
+                return Err(Error::Format("retained edge reaches pruned node".into()));
+            }
+            put_endpoint(&mut wide, at, entry);
+            let digest_at = if at == A_AT { 51 } else { 59 };
+            wide[digest_at..digest_at + 8].copy_from_slice(&entry[16..24]);
+        }
+        wide[24..28].copy_from_slice(&rec[8..12]);
+        wide[28..36].copy_from_slice(&rec[12..20]);
+        wide[36..46].copy_from_slice(&rec[20..30]);
+        wide[46..50].copy_from_slice(&rec[30..34]);
+        wide[50] = rec[34];
+        out.push(wide)?;
+        stats.edges += 1;
+    }
+    scratch.remove(edge_file)?;
+    scratch.remove(pruned.edge_comp)?;
+    Ok(out)
+}
