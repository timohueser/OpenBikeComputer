+#[cfg(target_arch = "wasm32")]
+pub fn sequential_cache_scan(reads: &dyn CellReads, block: usize, width: usize, len: usize) -> u32 {
+    let source = CellSlots(reads);
+    let cache = BlockCache::new(&source, block, vec!["sequential".into()], "source");
+    let mut buf = vec![0; width];
+    let mut sum = 0u32;
+    for offset in (0..len).step_by(width) {
+        let buf = &mut buf[..width.min(len - offset)];
+        cache.read_at(0, offset as u64, len as u64, buf).expect("sequential read");
+        for byte in buf {
+            sum = sum.wrapping_add(u32::from(*byte));
+        }
+    }
+    sum
