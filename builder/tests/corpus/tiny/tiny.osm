<?xml version='1.0' encoding='UTF-8'?>
<!--
  Hand-authored OBCM packer corpus fixture (unit-level).

  Every element here targets a specific branch of obcm/ingest.py's way/area
  disambiguation (§4.2 of builder/docs/rust-port-plan.md) so the Rust port's
  ingest can be validated against this file with the outcome known by
  construction. Coordinates sit near Freiburg (inland) on a tidy ~0.002 deg grid;
  exact positions are irrelevant, only the topology and tags are.

  Expected ingest result (with builder/presets/schema.json), all geometries in 4326 —
  11 features + 1 coastline, verified against the oracle (obcm/ingest.py):
    R1  (rel 201) -> 1 Polygon, natural=water, WITH one hole   (lake + island)
    R2  (rel 202) -> 2 Polygons, landuse=forest                (two outer rings)
    W5  (way 105) -> 1 Polygon, landuse=forest                 (closed-way area, heuristic)
    W11 (way 111) -> 1 Polygon, highway=pedestrian             (area=yes forces area)
    W6  (way 106) -> 1 LineString **and** 1 Polygon, highway=residential
                       (THE area-assembly trap: osmium's AreaManager builds a
                        polygon for every closed way except area=no / MP-members,
                        regardless of tags, so area() emits a residential polygon;
                        meanwhile way()'s heuristic doesn't classify residential as
                        an area, so it ALSO emits the line. Double-emit is real
                        oracle behaviour the Rust port must replicate.)
    W7  (way 107) -> 1 LineString, highway=primary             (simple line)
    W7b (way 108) -> 1 LineString, highway=trunk               (long: densified at serialize)
    W9  (way 110) -> 1 LineString, admin_level=2               (admin is line-only)
    W12 (way 112) -> 1 LineString, natural=water               (area=no: AreaManager
                       skips it, way() emits the line — single-emit)
    coastline: W8 (way 109) -> 1 LineString in coastlines[], not features
    dropped:   W10 (way 113, barrier=fence) -> no style match
  Untagged member ways 101-104 produce no standalone features (consumed by rels;
  AreaManager excludes MP members from standalone-area building).
-->
<osm version="0.6" generator="hand-authored-obcm-fixture">
  <!-- R1 lake-with-island: outer ring (W1) -->
  <node id="1" version="1" lat="47.990" lon="7.800"/>
  <node id="2" version="1" lat="47.990" lon="7.804"/>
  <node id="3" version="1" lat="47.994" lon="7.804"/>
  <node id="4" version="1" lat="47.994" lon="7.800"/>
  <!-- R1 inner ring (W2) -->
  <node id="5" version="1" lat="47.991" lon="7.801"/>
  <node id="6" version="1" lat="47.991" lon="7.803"/>
  <node id="7" version="1" lat="47.993" lon="7.803"/>
  <node id="8" version="1" lat="47.993" lon="7.801"/>
  <!-- R2 outer ring A (W3) -->
  <node id="9" version="1" lat="47.990" lon="7.806"/>
  <node id="10" version="1" lat="47.990" lon="7.808"/>
  <node id="11" version="1" lat="47.992" lon="7.808"/>
  <node id="12" version="1" lat="47.992" lon="7.806"/>
  <!-- R2 outer ring B (W4) -->
  <node id="13" version="1" lat="47.990" lon="7.810"/>
  <node id="14" version="1" lat="47.990" lon="7.812"/>
  <node id="15" version="1" lat="47.992" lon="7.812"/>
  <node id="16" version="1" lat="47.992" lon="7.810"/>
  <!-- W5 closed landuse=forest (heuristic area) -->
  <node id="17" version="1" lat="47.996" lon="7.800"/>
  <node id="18" version="1" lat="47.996" lon="7.803"/>
  <node id="19" version="1" lat="47.998" lon="7.803"/>
  <node id="20" version="1" lat="47.998" lon="7.800"/>
  <!-- W6 closed highway=residential (circular road -> line) -->
  <node id="21" version="1" lat="47.996" lon="7.806"/>
  <node id="22" version="1" lat="47.996" lon="7.808"/>
  <node id="23" version="1" lat="47.998" lon="7.808"/>
  <node id="24" version="1" lat="47.998" lon="7.806"/>
  <!-- W7 open highway=primary (simple line) -->
  <node id="25" version="1" lat="47.988" lon="7.800"/>
  <node id="26" version="1" lat="47.988" lon="7.812"/>
  <!-- W7b open highway=trunk (long segment -> densified) -->
  <node id="27" version="1" lat="47.980" lon="7.800"/>
  <node id="28" version="1" lat="47.980" lon="7.855"/>
  <!-- W8 open natural=coastline -->
  <node id="29" version="1" lat="47.990" lon="7.815"/>
  <node id="30" version="1" lat="47.994" lon="7.815"/>
  <!-- W9 open boundary=administrative admin_level=2 -->
  <node id="31" version="1" lat="48.000" lon="7.800"/>
  <node id="32" version="1" lat="48.000" lon="7.812"/>
  <!-- W11 closed highway=pedestrian area=yes (force area) -->
  <node id="33" version="1" lat="47.996" lon="7.810"/>
  <node id="34" version="1" lat="47.996" lon="7.812"/>
  <node id="35" version="1" lat="47.998" lon="7.812"/>
  <node id="36" version="1" lat="47.998" lon="7.810"/>
  <!-- W12 closed natural=water area=no (force line) -->
  <node id="37" version="1" lat="47.984" lon="7.800"/>
  <node id="38" version="1" lat="47.984" lon="7.803"/>
  <node id="39" version="1" lat="47.986" lon="7.803"/>
  <node id="40" version="1" lat="47.986" lon="7.800"/>
  <!-- W10 open barrier=fence (unmatched, dropped) -->
  <node id="41" version="1" lat="47.988" lon="7.806"/>
  <node id="42" version="1" lat="47.988" lon="7.808"/>

  <!-- W1: R1 outer (untagged member) -->
  <way id="101" version="1">
    <nd ref="1"/><nd ref="2"/><nd ref="3"/><nd ref="4"/><nd ref="1"/>
  </way>
  <!-- W2: R1 inner (untagged member) -->
  <way id="102" version="1">
    <nd ref="5"/><nd ref="6"/><nd ref="7"/><nd ref="8"/><nd ref="5"/>
  </way>
  <!-- W3: R2 outer A (untagged member) -->
  <way id="103" version="1">
    <nd ref="9"/><nd ref="10"/><nd ref="11"/><nd ref="12"/><nd ref="9"/>
  </way>
  <!-- W4: R2 outer B (untagged member) -->
  <way id="104" version="1">
    <nd ref="13"/><nd ref="14"/><nd ref="15"/><nd ref="16"/><nd ref="13"/>
  </way>
  <!-- W5: closed landuse=forest -> area via heuristic -->
  <way id="105" version="1">
    <nd ref="17"/><nd ref="18"/><nd ref="19"/><nd ref="20"/><nd ref="17"/>
    <tag k="landuse" v="forest"/>
  </way>
  <!-- W6: closed highway=residential -> circular road stays a line -->
  <way id="106" version="1">
    <nd ref="21"/><nd ref="22"/><nd ref="23"/><nd ref="24"/><nd ref="21"/>
    <tag k="highway" v="residential"/>
  </way>
  <!-- W7: open highway=primary -> simple line -->
  <way id="107" version="1">
    <nd ref="25"/><nd ref="26"/>
    <tag k="highway" v="primary"/>
  </way>
  <!-- W7b: open highway=trunk, >0.03 deg span -> densified at serialize -->
  <way id="108" version="1">
    <nd ref="27"/><nd ref="28"/>
    <tag k="highway" v="trunk"/>
  </way>
  <!-- W8: open natural=coastline -> coastlines[], not a styled feature -->
  <way id="109" version="1">
    <nd ref="29"/><nd ref="30"/>
    <tag k="natural" v="coastline"/>
  </way>
  <!-- W9: open admin boundary -> line only (area() skips admin_level) -->
  <way id="110" version="1">
    <nd ref="31"/><nd ref="32"/>
    <tag k="boundary" v="administrative"/>
    <tag k="admin_level" v="2"/>
  </way>
  <!-- W11: closed highway=pedestrian area=yes -> forced area -->
  <way id="111" version="1">
    <nd ref="33"/><nd ref="34"/><nd ref="35"/><nd ref="36"/><nd ref="33"/>
    <tag k="highway" v="pedestrian"/>
    <tag k="area" v="yes"/>
  </way>
  <!-- W12: closed natural=water area=no -> forced line -->
  <way id="112" version="1">
    <nd ref="37"/><nd ref="38"/><nd ref="39"/><nd ref="40"/><nd ref="37"/>
    <tag k="natural" v="water"/>
    <tag k="area" v="no"/>
  </way>
  <!-- W10: open barrier=fence -> no style match, dropped -->
  <way id="113" version="1">
    <nd ref="41"/><nd ref="42"/>
    <tag k="barrier" v="fence"/>
  </way>

  <!-- R1: multipolygon natural=water, outer + inner (lake with island) -->
  <relation id="201" version="1">
    <member type="way" ref="101" role="outer"/>
    <member type="way" ref="102" role="inner"/>
    <tag k="type" v="multipolygon"/>
    <tag k="natural" v="water"/>
  </relation>
  <!-- R2: multipolygon landuse=forest, two outer rings -->
  <relation id="202" version="1">
    <member type="way" ref="103" role="outer"/>
    <member type="way" ref="104" role="outer"/>
    <tag k="type" v="multipolygon"/>
    <tag k="landuse" v="forest"/>
  </relation>
</osm>
