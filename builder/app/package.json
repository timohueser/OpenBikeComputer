{
    "name": "obcm-web-builder",
    "private": true,
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:web": "vite build --mode web",
        "build:desktop": "vite build --mode desktop",
        "build:all": "npm run build && npm run build:web && npm run build:desktop",
        "build:wasm": "npm run build:wasm:convert && npm run build:wasm:assemble && npm run build:wasm:preview",
        "build:wasm:convert": "wasm-pack build ../../apps/obc-web-convert --release --target web --out-dir ../../builder/app/src/lib/convert/pkg --out-name obc_web_convert",
        "build:wasm:assemble": "wasm-pack build ../../apps/obc-web-assemble --release --target web --out-dir ../../builder/app/src/lib/assemble/pkg --out-name obc_web_assemble",
        "build:wasm:preview": "wasm-pack build ../../apps/obc-web-preview --release --target web --out-dir ../../builder/app/src/lib/skin/pkg --out-name obc_web_preview",
        "preview": "vite preview",
        "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
        "test": "vitest run"
    },
    "dependencies": {
        "@tauri-apps/api": "^2.11.1",
        "leaflet": "^1.9.4"
    },
    "devDependencies": {
        "@sveltejs/vite-plugin-svelte": "^6.0.0",
        "@tsconfig/svelte": "^5.0.4",
        "@types/leaflet": "^1.9.12",
        "@types/node": "^22.20.1",
        "svelte": "^5.20.0",
        "svelte-check": "^4.0.0",
        "typescript": "^5.6.0",
        "vite": "^7.0.0",
        "vitest": "^3.0.0"
    }
}
