      "weather-raw-tile.obcw": {"byte_len": 876, "internal_crc32": "0xC0AFE59C", "sha256": "da32b2db8eddb497de5ff83ec9dd7570cab5d046bbfbe8e43c13d30b55b07f79", "shape": "one 128-byte raw4 tile"},
