      "obcm_version": 13,
      "_note": "obcm_version is the OBCM map-format version the reader reads (obc_formats::obcm::VERSION), NOT the protocol version beside it. The builder self-sources it, so an OBCM bump re-cuts this fixture and this number on purpose."
    },
    "version-read-noobcm.bin": {
      "format": "protocolVersion read (spec 1), pre-#911 — version u16 · store_epoch u32",
      "byte_len": 6,
      "version": 2,
      "store_epoch": "0xA1B2C3D4",
      "obcm_version": null,
      "_note": "A firmware that predates the obcm_version byte. Decoders take the absent field as unknown (null/nil/None), never as 0 — obcm_version 0 would read as 'supports OBCM v0' and refuse every real map."
    },
