      "weather-invalid-nibble.obcw": "raw4 contains reserved intensity 13; CRC recomputed",
      "weather-invalid-raw-compressible.obcw": "all-dry tile is labeled raw4 although canonical RLE4 is 16 bytes; CRC recomputed",
      "weather-invalid-rle-overlong.obcw": "RLE expands past 256 cells; CRC recomputed",
      "weather-invalid-rle-noncanonical.obcw": "adjacent equal short RLE runs are not maximal; CRC recomputed",
