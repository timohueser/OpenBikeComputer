# One weather cycle: `systemctl start obc-wx-bake@cycle.service`.
#
# The instance name (%i) is the `obc-wx-bake` subcommand. Installed by ops/weather/install.sh
# to /etc/systemd/system/; the timer is generated from ops/weather/adapters.conf, which has one
# row since #1246 because the bakery publishes one dataset.
#
# **Always start a bake through this unit, never as a bare `obc-wx-bake cycle --r2`.** The flock
# below lives in ExecStart, not in the binary, so a hand-typed invocation is outside it — and two
# overlapping cycles can publish a manifest that goes backwards over a newer one. The baker refuses
# that outright now (`canonical::refuse_to_go_backwards`), which turns the mistake into a lost tick
# instead of a live manifest naming swept generations, but the lock is what stops it happening.
#
# Type=oneshot with no Restart=: a failed bake publishes nothing and leaves the previous manifest
# intact, so the correct response to a failure is to wait for the next timer tick, not to retry
# in a tight loop against an upstream that is already unhappy. Failures are visible in
# `systemctl list-timers` / `systemctl status` and, externally, as staleness in the manifest —
# which is what the freshness probe watches. The box never alerts about itself.

[Unit]
Description=OBC weather bakery — bake and publish the %i dataset
Documentation=https://github.com/timohueser/OpenBikeComputer/blob/develop/ops/weather/RUNBOOK.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=obc-wx
Group=obc-wx

# The R2 credentials. systemd reads this file as root before dropping privileges, so it stays
# 0600 root:root — the service user itself cannot read the secret outside this unit.
EnvironmentFile=/etc/obc-wx/r2.env

WorkingDirectory=/var/lib/obc-wx

# flock serializes every instance of this template against every other. The manifest is a
# read-modify-write of one object: two cycles publishing at the same instant race, and the loser
# republishes an older chain over a newer one — which names generations the newer cycle's retention
# sweep already deleted (WXR8 #1247). --wait 240 lets one tick queue behind a running cycle and then
# give up rather than pile up: a cycle still running four minutes in is already anomalous, and the
# next tick's data is better than a queued one's.
ExecStart=/usr/bin/flock --wait 240 /var/lib/obc-wx/bake.lock /usr/local/bin/obc-wx-bake %i --r2

# Re-derived for the mosaic + sweep (WXR8 #1247); it was set when a cycle was four small products
# and a 2 s bake. One cycle is now: seven upstream fetches, a 648 M-cell mosaic (WXR1 #1254 measured
# 12.4 s of bake on 8 cores, so under a minute on the 4-vCPU box), then ~217 rclone `copyto` spawns,
# ~217 `size` spawns proving every object fetchable, and up to 216 `deletefile` spawns retiring the
# generation that fell off the chain — ~650 process spawns at ~0.2 s each ≈ 130 s. 300 s had ~20 %
# headroom over that; 600 s has a comfortable multiple, and the timer is 900 s apart so a cycle that
# needs it still cannot collide with its successor.
#
# A SIGKILL mid-sweep is safe by construction: the sweep runs only after the manifest swap, so
# everything it is deleting is already unreferenced, and whatever it did not reach is collected by
# the bucket's 1-day lifecycle rule. A SIGKILL before the swap publishes nothing.
TimeoutStartSec=600
KillMode=mixed
KillSignal=SIGTERM
FinalKillSignal=SIGKILL

# journald is the log. Retention is bounded by journald.conf (install.sh sets SystemMaxUse).
StandardOutput=journal
StandardError=journal
SyslogIdentifier=obc-wx-bake

# ── Resource caps ────────────────────────────────────────────────────────────────────────────
# The epic's budget is <1 GB RSS per cycle. This was set against the multi-product baker's measured
# 52 MB (RV+ICON, #1215); the mosaic's measured peak is **398 MB** at BAKE_THREADS=4 (WXR1 #1254),
# so the old MemoryHigh=384M sat *below* the measurement and would have throttled every cycle.
#
# **There is no MemoryHigh any more, and that is the deliberate half** (#1274 r2). MemoryHigh is a
# throttle, not a ceiling: crossing it does not fail anything, it applies reclaim pressure and makes
# the cycle slower. Against a single 398 MB measurement and a 600 s deadline, any MemoryHigh we
# could honestly justify would be close enough to the measurement to convert a normal spike — a
# wetter planet, a larger upstream field — into a slow cycle, and a slow enough cycle into a
# TimeoutStartSec kill. That trades a soft, invisible condition for a hard one, in the direction
# nobody wants.
#
# MemoryMax stays as the one number: a hard, fail-closed ceiling at the epic's stated budget and
# 2.5x the measurement. An OOM-killed bake publishes nothing, exactly like any other failure, and
# the previous generation stands. Raise it here (and only here), and only with a measurement.
MemoryMax=1G
TasksMax=64
# Bakes are background work on a box that must stay responsive to ssh.
Nice=5
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# ── Hardening ────────────────────────────────────────────────────────────────────────────────
# This process fetches untrusted bytes from five upstreams and decodes them with tar/bzip2/GRIB2/
# HDF5 parsers. Give it the smallest box that still lets it do its job: no privileges, no devices,
# no home directories, a read-only system, one writable state directory, and outbound TCP only.
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/obc-wx
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
# Upstream weather lives on the public internet; the cloud metadata endpoint (169.254.169.254)
# does not. Walling off link-local costs this service nothing and takes credential theft off the
# table for the tar/bzip2/GRIB2/HDF5 parsers that chew on untrusted bytes all day.
IPAddressDeny=link-local
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
UMask=0077
